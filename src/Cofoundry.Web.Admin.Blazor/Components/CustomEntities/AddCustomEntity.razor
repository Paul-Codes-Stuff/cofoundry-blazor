@page "/{CustomEntityDefinitionCode}/new"
@page "/custom-entities/{CustomEntityDefinitionCode}/new"
@inject IAdminBlazorExecutor Executor
@inject NavigationManager Navigation

<PageTitle>Create @(_module?.Definition.Name) | Admin</PageTitle>

<PageHeader Title="Create" ParentTitle="@_module?.Definition.NamePlural" ParentHref="@ListUrl" />

@if (_module == null)
{
    <PageBody ContentType="form">
        @if (_notFound)
        {
            <p class="message warning perm">Sorry, that custom entity type could not be found.</p>
        }
        else
        {
            <TableContainer IsLoading="true" />
        }
    </PageBody>
}
else
{
    <CustomEntityAddForm @key="_module" Module="_module" ShowTemplateSections="true" OnSaved="OnSavedAsync" OnCancel="Cancel" />
}

@code {
    private CustomEntityModule? _module;
    private bool _notFound;

    /// <summary>
    /// The definition's slug or code (see <see cref="CustomEntityRoute"/>).
    /// </summary>
    [Parameter] public string CustomEntityDefinitionCode { get; set; } = string.Empty;

    private string? ListUrl => _module == null ? null : AdminBlazorRoutes.CustomEntities(_module.Code);

    protected override async Task OnParametersSetAsync()
    {
        var definitionCode = CustomEntityRoute.GetDefinitionCode(Navigation, CustomEntityDefinitionCode);
        _module = definitionCode == null ? null : await CustomEntityModule.LoadAsync(Executor, definitionCode);
        _notFound = _module == null;
    }

    private async Task OnSavedAsync(int customEntityId, bool thenEditContent)
    {
        if (thenEditContent && await GetVisualEditorUrlAsync(customEntityId) is { } editorUrl)
        {
            // forceLoad: the visual editor is served by the MVC site, not by this Blazor app.
            Navigation.NavigateTo(editorUrl, forceLoad: true);
        }
        else
        {
            Navigation.NavigateTo(AdminBlazorRoutes.CustomEntityDetails(_module!.Code, customEntityId));
        }
    }

    /// <summary>
    /// Null when the entity has no url yet (e.g. no page uses its template), in which case the
    /// AngularJS admin also fell back to the details page.
    /// </summary>
    private async Task<string?> GetVisualEditorUrlAsync(int customEntityId)
    {
        var entity = await Executor.QueryAsync(new GetCustomEntityDetailsByIdQuery(customEntityId));

        return string.IsNullOrEmpty(entity?.FullUrlPath) ? null : CustomEntityUrls.VisualEditor(entity.FullUrlPath);
    }

    private void Cancel() => Navigation.NavigateTo(ListUrl!);
}
