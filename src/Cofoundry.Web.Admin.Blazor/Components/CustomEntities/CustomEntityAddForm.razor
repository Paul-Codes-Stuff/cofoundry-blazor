@inject IAdminBlazorExecutor Executor
@inject AdminLookups Lookups

@* The create form shared by the create page and AddCustomEntityDialog (the "Add" button on custom entity
   pickers), as AddCustomEntity.html and AddCustomEntityDialog.html were near copies. *@
@if (_command == null)
{
    <PageBody ContentType="form"><TableContainer IsLoading="true" /></PageBody>
}
else
{
    var definition = Module.Definition;

    <AdminForm @ref="_form" Model="_command" IsLoading="_isSaving" OnValidSubmit="() => SaveAsync(false, false)">

        <PageActions>
            <AdminButton Text="@Module.SaveAndPublishText" Class="main-cta" IsLoading="_isSaving && _isPublishing" Disabled="_isSaving"
                         OnClick="() => SaveAsync(true, false)" />
            @if (!definition.AutoPublish)
            {
                <AdminButtonSubmit Text="Save Draft" IsLoading="_isSaving && !_isPublishing" Disabled="_isSaving" />
            }
            <AdminButton Text="Cancel" Disabled="_isSaving" OnClick="OnCancel" />
        </PageActions>

        <PageBody ContentType="form">

            <FormStatus Errors="_errors" />

            <FormSection Title="Main">

                @if (definition.HasLocale && _locales.Count > 1)
                {
                    <FormFieldDropdown TValue="int?" Title="Market" Options="_locales" @bind-Value="_command.LocaleId" />
                }

                <FormFieldText Title="@Module.TitleTerm" MaxLength="200"
                               Value="@_command.Title" ValueChanged="OnTitleChanged"
                               ValueExpression="() => _command.Title" />

                @if (!definition.AutoGenerateUrlSlug)
                {
                    <FormFieldText Title="@Module.UrlSlugTerm" MaxLength="200"
                                   Description="Lower case and containing only letter, numbers, underscores and hyphens. E.g. 'rock-and-roll'"
                                   @bind-Value="_command.UrlSlug" />
                }

            </FormSection>

            @if (Module.HasProperties)
            {
                <FormSection Title="Properties">
                    <DataModelFieldSet Model="_command.Model" Schema="Module.Schema" Context="@(new DataModelFieldContext(_command.LocaleId))" />
                </FormSection>
            }

            @foreach (var pageRoute in _pageRoutes)
            {
                <FormSection Title="@($"Template: {pageRoute.Title}")">
                    <FormSectionActions>
                        <AdminButton Text="@SaveAndEditText" IsLoading="_isSaving && !_isPublishing" Disabled="_isSaving"
                                     OnClick="() => SaveAsync(false, true)" />
                    </FormSectionActions>
                    <FormFieldContainer>
                        <div>Template content can only be managed after the @definition.Name.ToLowerInvariant() has been created.</div>
                    </FormFieldContainer>
                </FormSection>
            }

        </PageBody>
    </AdminForm>
}

@code {
    private AdminForm? _form;
    private AddCustomEntityCommand? _command;
    private IReadOnlyList<SelectOption<int?>> _locales = [];
    private IReadOnlyCollection<PageRoute> _pageRoutes = [];
    private IReadOnlyCollection<ValidationError> _errors = [];
    private bool _isSaving;
    private bool _isPublishing;

    [Parameter, EditorRequired] public CustomEntityModule Module { get; set; } = default!;

    /// <summary>
    /// Shows a section per page template that displays this entity type, with a "Save &amp; Edit Content"
    /// button. Only the create page does; the dialog leaves it out, as in the AngularJS admin.
    /// </summary>
    [Parameter] public bool ShowTemplateSections { get; set; }

    /// <summary>
    /// Called with the new entity's id and whether "Save &amp; Edit Content" was used.
    /// </summary>
    [Parameter] public Func<int, bool, Task>? OnSaved { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private string SaveAndEditText => Module.Definition.AutoPublish ? "Save & Edit Content" : "Save Draft & Edit Content";

    protected override async Task OnInitializedAsync()
    {
        var localesTask = Module.Definition.HasLocale
            ? Lookups.GetLocaleOptionsAsync()
            : Task.FromResult<IReadOnlyList<SelectOption<int?>>>([]);
        var routesTask = ShowTemplateSections
            ? Executor.QueryAsync(new GetPageRoutesByCustomEntityDefinitionCodeQuery(Module.Code))
            : Task.FromResult<IReadOnlyCollection<PageRoute>>([]);
        await Task.WhenAll(localesTask, routesTask);

        _locales = localesTask.Result;
        _pageRoutes = routesTask.Result;

        _command = new AddCustomEntityCommand
        {
            CustomEntityDefinitionCode = Module.Code,
            Model = Module.CreateDefaultModel()
        };
    }

    private void OnTitleChanged(string? title)
    {
        _command!.Title = title ?? string.Empty;
        _command.UrlSlug = StringUtilities.Slugify(title, 200);
    }

    private async Task SaveAsync(bool publish, bool thenEditContent)
    {
        if (_isSaving || _form == null || !_form.Validate())
        {
            return;
        }

        if (Module.Definition.AutoGenerateUrlSlug)
        {
            _command!.UrlSlug = null;
        }

        _command!.Publish = publish;
        _isPublishing = publish;
        _isSaving = true;
        _errors = [];

        try
        {
            var result = await Executor.ExecuteAsync(_command);

            if (!result.Succeeded)
            {
                _errors = result.Errors;
                return;
            }
        }
        finally
        {
            _isSaving = false;
        }

        if (OnSaved != null)
        {
            await OnSaved(_command.OutputCustomEntityId, thenEditContent);
        }
    }
}
