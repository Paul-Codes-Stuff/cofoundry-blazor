@implements IDisposable
@inject DebugSettings DebugSettings
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment

@* Mirrors the modal markup and class behaviour of the AngularJS cmsModalDialogContainer directive.
   Rendered into the layout's outlet for this dialog's level in the ModalDialogStack, so a dialog
   opened from inside another stacks on top of it. The outlet is outside the layout's error boundary,
   so the dialog has its own for exceptions while its content renders (which would otherwise end the
   circuit): they show in the dialog, are logged (see IAdminBlazorErrorHandler) and leave the page
   behind as it was. An event handler's exception goes to the component that handles it instead (e.g.
   ConfirmDialog, in the page), so the layout's boundary shows those. *@
<SectionContent SectionName="@ModalDialogStack.GetSectionName(_level)">
<AdminErrorBoundary>
    <ChildContent>
        @RenderDialog(ChildContent)
    </ChildContent>
    <ErrorContent Context="exception">
        @RenderDialog(RenderError(exception))
    </ErrorContent>
</AdminErrorBoundary>
</SectionContent>

@code {
    private static int _instanceCount;

    // Unique per dialog, so field ids don't clash with the form behind the dialog or another dialog.
    private readonly string _fieldIdPrefix = $"modal{Interlocked.Increment(ref _instanceCount)}-";

    private bool _show;
    private int _level;

    [CascadingParameter] public ModalDialogStack? Stack { get; set; }

    /// <summary>
    /// Header text. When empty the header (and its close button) is not rendered.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Use "large" for form dialogs. Anything else gives the default size.
    /// </summary>
    [Parameter] public string? Size { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private RenderFragment RenderDialog(RenderFragment? content) => __builder =>
    {
        <div class="modal @SizeCssClass @StackCssClass @ShowCssClass">
            <div class="modal-dialog">
                <div class="modal-content">

                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <div class="modal-header">
                            <a href="" class="close btn-icon" aria-hidden="true" @onclick="OnClose" @onclick:preventDefault>
                                <i class="fa fa-times"></i>
                            </a>
                            <h4 class="modal-title">@Title</h4>
                        </div>
                    }

                    <CascadingValue Name="FieldIdPrefix" Value="_fieldIdPrefix" IsFixed="true">
                        @content
                    </CascadingValue>

                </div>
            </div>
        </div>
        <div class="modal-background @SizeCssClass @ShowCssClass" @onclick="OnClose"></div>
    };

    private RenderFragment RenderError(Exception exception) => __builder =>
    {
        <div class="modal-actions">
            <AdminButton Text="Close" Class="main-cta" OnClick="OnClose" />
        </div>
        <div class="modal-body modal-body-error">
            <p>Sorry, an unexpected error has occurred.</p>
            @if (DebugSettings.CanShowDeveloperExceptionPage(HostEnvironment))
            {
                <pre class="developer-exception">@exception</pre>
            }
        </div>
    };

    private string SizeCssClass => Size == "large" ? "modal-lg" : string.Empty;

    private string StackCssClass => _level == 0 ? "is-root-modal" : "is-child-modal";

    protected override void OnInitialized()
    {
        _level = Stack?.Acquire() ?? 0;
    }

    // The css keeps the modal transparent until 'modal--show' is added, which is what drives the
    // fade/slide-in. The AngularJS directive adds it a tick after render; we do it after first render.
    private string ShowCssClass => _show ? "modal--show" : string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(1);
            _show = true;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Stack?.Release(_level);
    }
}
