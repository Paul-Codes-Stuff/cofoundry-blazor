@implements IDisposable

@* Mirrors the modal markup and class behaviour of the AngularJS cmsModalDialogContainer directive.
   Rendered into the layout's outlet for this dialog's level in the ModalDialogStack, so a dialog
   opened from inside another stacks on top of it. *@
<SectionContent SectionName="@ModalDialogStack.GetSectionName(_level)">
<div class="modal @SizeCssClass @StackCssClass @ShowCssClass">
    <div class="modal-dialog">
        <div class="modal-content">

            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="modal-header">
                    <a href="" class="close btn-icon" aria-hidden="true" @onclick="OnClose" @onclick:preventDefault>
                        <i class="fa fa-times"></i>
                    </a>
                    <h4 class="modal-title">@Title</h4>
                </div>
            }

            <CascadingValue Name="FieldIdPrefix" Value="_fieldIdPrefix" IsFixed="true">
                @ChildContent
            </CascadingValue>

        </div>
    </div>
</div>
<div class="modal-background @SizeCssClass @ShowCssClass" @onclick="OnClose"></div>
</SectionContent>

@code {
    private static int _instanceCount;

    // Unique per dialog, so field ids don't clash with the form behind the dialog or another dialog.
    private readonly string _fieldIdPrefix = $"modal{Interlocked.Increment(ref _instanceCount)}-";

    private bool _show;
    private int _level;

    [CascadingParameter] public ModalDialogStack? Stack { get; set; }

    /// <summary>
    /// Header text. When empty the header (and its close button) is not rendered.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Use "large" for form dialogs. Anything else gives the default size.
    /// </summary>
    [Parameter] public string? Size { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string SizeCssClass => Size == "large" ? "modal-lg" : string.Empty;

    private string StackCssClass => _level == 0 ? "is-root-modal" : "is-child-modal";

    protected override void OnInitialized()
    {
        _level = Stack?.Acquire() ?? 0;
    }

    // The css keeps the modal transparent until 'modal--show' is added, which is what drives the
    // fade/slide-in. The AngularJS directive adds it a tick after render; we do it after first render.
    private string ShowCssClass => _show ? "modal--show" : string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(1);
            _show = true;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Stack?.Release(_level);
    }
}
