@page "/admin-next/images/{ImageAssetId:int}"
@inject IAdminBlazorExecutor Executor
@inject NavigationManager Navigation

<PageTitle>@(_image?.Title ?? "Image") | Admin</PageTitle>

<PageHeader Title="@_image?.Title" ParentTitle="Images" ParentHref="@AdminBlazorRoutes.Images" />

@if (_image == null || _command == null || _permissions == null)
{
    <PageBody ContentType="form">
        @if (_notFound)
        {
            <p class="message warning perm">Sorry, that image could not be found.</p>
        }
        else
        {
            <TableContainer IsLoading="true" />
        }
    </PageBody>
}
else
{
    <AdminForm Model="_command" EditMode="_editMode" IsLoading="_isLoading" OnValidSubmit="SaveAsync">

        @if (!_editMode)
        {
            <PageActions>
                @if (_permissions.CanUpdate)
                {
                    <AdminButton Text="Edit" Class="main-cta" Disabled="_isLoading" OnClick="BeginEdit" />
                }
                @if (_permissions.CanDelete)
                {
                    <AdminButton Text="Delete" Disabled="_isLoading" OnClick="() => _isDeleteDialogOpen = true" />
                }
            </PageActions>
        }
        else
        {
            <PageActions>
                <AdminButtonSubmit Text="Save" IsLoading="_isLoading" Disabled="_isLoading" />
                <AdminButton Text="Cancel" Disabled="_isLoading" OnClick="CancelEdit" />
            </PageActions>
        }

        <PageBody ContentType="form">

            <FormStatus Errors="_errors" SuccessMessage="@_message" />

            <FormSection Title="Main">

                <FormFieldImageUpload Title="File"
                                      CurrentAsset="_image"
                                      @bind-Value="_command.File"
                                      Disabled="_isLoading" />

                <FormFieldText Title="Title" MaxLength="130" @bind-Value="_command.Title" />

                <FormFieldReadonly Title="Path" Description="Full path to the image asset file." Value="@_image.Url" />

                @if (_command.File != null ? !FormFieldImageUpload.IsSvg(_command.File) : _image.FileExtension != ImageAssetConstants.SvgFileExtension)
                {
                    <FormFieldImageAnchorLocation @bind-Value="_command.DefaultAnchorLocation" />
                }

                <FormFieldTags Title="CMS Tags" @bind-Value="_command.Tags" />

            </FormSection>

            <AuditDataSection AuditData="_image.AuditData" />

        </PageBody>

    </AdminForm>

    @if (_isDeleteDialogOpen)
    {
        <ConfirmDialog Title="Delete Image" Message="Are you sure you want to delete this image?"
                       OkButtonTitle="Yes, delete it"
                       OnOk="DeleteAsync"
                       OnClosed="OnDeleteClosed" />
    }
}

@code {
    private ImageAssetDetails? _image;
    private CrudPermissions? _permissions;
    private UpdateImageAssetCommand? _command;
    private IReadOnlyCollection<ValidationError> _errors = [];
    private string? _message;
    private bool _editMode;
    private bool _isLoading;
    private bool _isDeleteDialogOpen;
    private bool _deleted;
    private bool _notFound;

    [Parameter] public int ImageAssetId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _permissions ??= await CrudPermissions.LoadImagesAsync(Executor);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        var image = await Executor.QueryAsync(new GetImageAssetDetailsByIdQuery(ImageAssetId));

        if (image == null)
        {
            _notFound = true;
            return;
        }

        _image = image;
        _command = MapCommand(image);
        _editMode = false;
    }

    private static UpdateImageAssetCommand MapCommand(ImageAssetDetails image)
    {
        return new UpdateImageAssetCommand
        {
            ImageAssetId = image.ImageAssetId,
            Title = image.Title,
            Tags = image.Tags,
            DefaultAnchorLocation = image.DefaultAnchorLocation
        };
    }

    private void BeginEdit()
    {
        _editMode = true;
        _errors = [];
        _message = null;
    }

    private void CancelEdit()
    {
        _editMode = false;
        _command = MapCommand(_image!);
        _errors = [];
    }

    private async Task SaveAsync()
    {
        _isLoading = true;
        _errors = [];
        _message = null;

        try
        {
            var result = await Executor.ExecuteAsync(_command!);

            if (!result.Succeeded)
            {
                _errors = result.Errors;
                return;
            }

            await LoadAsync();
            _message = "Changes were saved successfully";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteAsync()
    {
        _errors = [];
        _message = null;

        var result = await Executor.ExecuteAsync(new DeleteImageAssetCommand { ImageAssetId = ImageAssetId });

        if (result.Succeeded)
        {
            _deleted = true;
        }
        else
        {
            _errors = result.Errors;
        }
    }

    private void OnDeleteClosed(bool confirmed)
    {
        _isDeleteDialogOpen = false;

        if (confirmed && _deleted)
        {
            Navigation.NavigateTo(AdminBlazorRoutes.Images);
        }
    }
}
