@inject IAdminBlazorExecutor Executor

@* Port of UploadImageAssetDialog, opened from the image picker's "Upload" action. *@
<ModalDialog Title="Upload an image" Size="large" OnClose="() => OnClosed.InvokeAsync(null)">

    <AdminForm @ref="_form" Model="_command" IsLoading="_isSaving" OnValidSubmit="UploadAsync">

        <PageActions>
            <AdminButtonSubmit Text="Upload" IsLoading="_isSaving" Disabled="_isSaving" />
            <AdminButton Text="Cancel" Disabled="_isSaving" OnClick="() => OnClosed.InvokeAsync(null)" />
        </PageActions>

        <PageBody>

            <FormStatus Errors="_errors" />

            @if (_restrictions.Length > 0)
            {
                <WarningMessage>This image field has restrictions: @_restrictions</WarningMessage>
            }

            <FormSection Title="Image details">

                <FormFieldImageUpload Title="File" Required="true"
                                      Value="_command.File"
                                      ValueChanged="OnFileChanged"
                                      ValueExpression="() => _command.File"
                                      Filter="Filter"
                                      Disabled="_isSaving" />

                <FormFieldText Title="Title" MaxLength="130" @bind-Value="_command.Title" />

                <FormFieldTags Title="CMS Tags" @bind-Value="_command.Tags" />

                @if (_command.File != null && !FormFieldImageUpload.IsSvg(_command.File))
                {
                    <FormFieldImageAnchorLocation @bind-Value="_command.DefaultAnchorLocation" />
                }

            </FormSection>

        </PageBody>

    </AdminForm>

</ModalDialog>

@code {
    private AdminForm? _form;
    private readonly AddImageAssetCommand _command = new();
    private IReadOnlyCollection<ValidationError> _errors = [];
    private bool _isSaving;
    private string _restrictions = string.Empty;

    /// <summary>
    /// The picker's preset filter: its size restrictions are shown as a warning and its tags are added
    /// to the new image.
    /// </summary>
    [Parameter] public ImageAssetFilter? Filter { get; set; }

    /// <summary>
    /// Called with the new image's id once uploaded, or null if the dialog was cancelled.
    /// </summary>
    [Parameter] public EventCallback<int?> OnClosed { get; set; }

    protected override void OnInitialized()
    {
        _restrictions = Filter?.DescribeSize() ?? string.Empty;
        _command.Tags = ImageAssetFilter.SplitTags(Filter?.Tags);
    }

    private void OnFileChanged(IFileSource? file)
    {
        _command.File = file!;

        if (file != null)
        {
            _command.Title = StringUtilities.TitleFromFileName(file.FileName);
            _form?.NotifyFieldChanged(() => _command.Title);
        }
    }

    private async Task UploadAsync()
    {
        _isSaving = true;
        _errors = [];

        try
        {
            var result = await Executor.ExecuteAsync(_command);

            if (!result.Succeeded)
            {
                _errors = result.Errors;
                return;
            }

            await OnClosed.InvokeAsync(_command.OutputImageAssetId);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
