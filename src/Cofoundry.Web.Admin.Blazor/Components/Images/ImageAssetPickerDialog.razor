@inject IAdminBlazorExecutor Executor

@* Port of ImageAssetPickerDialog. In single mode a click selects one image and double-click selects and
   closes. In multi mode (SelectedIds set) clicks toggle images in and out of the selection. New images can
   be uploaded from the table's "+" action; the upload is selected and the dialog closes. A preset Filter
   (from the field's attribute) is applied and can't be changed. *@
<ModalDialog Title="Find an image" Size="large" OnClose="CancelAsync">

    <PageActions>
        <AdminButton Text="@(IsMultiMode ? "Ok" : "Select")" Class="main-cta" Disabled="!IsMultiMode && _selected == null" OnClick="OkAsync" />
        <AdminButton Text="Cancel" OnClick="CancelAsync" />
        <AdminButton Text="Filter" OnClick="() => _isFilterVisible = !_isFilterVisible" />

        @if (_isFilterVisible)
        {
            <AdminForm Model="_filter" OnValidSubmit="ApplyFilter" CssClass="search-filter">
                <FormSection Title="Filter this list">

                    <FormFieldText Title="Tags" Disabled="Preset.Tags != null" @bind-Value="_filter.Tags" />
                    @if (Preset.MinWidth == null)
                    {
                        <FormFieldNumber Title="Width" Min="0" Disabled="Preset.Width != null" @bind-Value="_filter.Width" />
                    }
                    @if (Preset.MinHeight == null)
                    {
                        <FormFieldNumber Title="Height" Min="0" Disabled="Preset.Height != null" @bind-Value="_filter.Height" />
                    }
                    @if (Preset.Width == null)
                    {
                        <FormFieldNumber Title="Min Width" Min="0" Disabled="Preset.MinWidth != null" @bind-Value="_filter.MinWidth" />
                    }
                    @if (Preset.Height == null)
                    {
                        <FormFieldNumber Title="Min Height" Min="0" Disabled="Preset.MinHeight != null" @bind-Value="_filter.MinHeight" />
                    }

                </FormSection>
                <div class="form-actions">
                    <AdminButtonSubmit Text="Apply" />
                    <AdminButton Text="Clear" OnClick="ClearFilter" />
                </div>
            </AdminForm>
        }

        <Pager PageNumber="_result?.PageNumber ?? 1" PageCount="_result?.PageCount ?? 0" OnPageChanged="GoToPage" />
    </PageActions>

    <PageBody>
        <TableContainer IsLoading="_isLoading">
            <table class="table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Title</th>
                        <th>Size</th>
                        <th>Tags</th>
                        <th>Modified</th>
                        <th class="actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_result != null && _result.Items.Count == 0)
                    {
                        <tr><td colspan="100" class="empty">Sorry, no images could be found.</td></tr>
                    }
                    @foreach (var image in _result?.Items ?? [])
                    {
                        var isSelected = IsSelected(image.ImageAssetId);

                        <tr @key="image.ImageAssetId"
                            class="@(isSelected ? "selected" : "selectable")"
                            @onclick="() => Select(image)"
                            @ondblclick="() => SelectAndCloseAsync(image)">
                            <td>
                                <TableCellImage Image="image" />
                            </td>
                            <td>@image.Title</td>
                            <td>
                                <strong>@image.Width x @image.Height</strong>
                                <div>@StringUtilities.FormatBytes(image.FileSizeInBytes)</div>
                            </td>
                            <td>
                                <TagList Tags="image.Tags" />
                            </td>
                            <td class="lowPriority">
                                <UpdatedAuditDataCell AuditData="image.AuditData" />
                            </td>
                            <td class="actions">
                                <ButtonIcon Icon="@(isSelected ? "check-square-o" : "square-o")" Title="@(isSelected ? "Selected" : "Select")" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (_canCreate)
            {
                <div class="collection-actions">
                    <a href="" class="btn-icon" title="Upload" @onclick="() => _isUploadOpen = true" @onclick:preventDefault>
                        <i class="fa fa-plus-circle"></i>
                    </a>
                </div>
            }
        </TableContainer>
    </PageBody>

</ModalDialog>

@if (_isUploadOpen)
{
    <UploadImageAssetDialog Filter="Preset" OnClosed="OnUploadClosedAsync" />
}

@code {
    // The AngularJS SearchQuery default.
    private const int DefaultPageSize = 30;

    private readonly PickerFilter _filter = new();
    private List<int> _selectedIds = [];
    private SearchImageAssetSummariesQuery _query = new() { PageNumber = 1, PageSize = DefaultPageSize };
    private PagedQueryResult<ImageAssetSummary>? _result;
    private IImageAssetRenderable? _selected;
    private bool _canCreate;
    private bool _isFilterVisible;
    private bool _isLoading;
    private bool _isUploadOpen;

    /// <summary>
    /// Single mode: the image currently chosen in the field, highlighted as selected when the dialog opens.
    /// </summary>
    [Parameter] public IImageAssetRenderable? CurrentAsset { get; set; }

    /// <summary>
    /// Setting this opens the dialog in multi mode, with these images selected (a collection field).
    /// </summary>
    [Parameter] public IReadOnlyCollection<int>? SelectedIds { get; set; }

    /// <summary>
    /// Restrictions from the field's attribute, applied to the list and to uploads.
    /// </summary>
    [Parameter] public ImageAssetFilter? Filter { get; set; }

    /// <summary>
    /// Single mode: called with the chosen image when "Select" is clicked (or a row double-clicked).
    /// </summary>
    [Parameter] public EventCallback<IImageAssetRenderable> OnSelected { get; set; }

    /// <summary>
    /// Multi mode: called with the selected ids, in selection order, when "Ok" is clicked.
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyList<int>> OnSelectedIds { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private bool IsMultiMode => SelectedIds != null;

    private ImageAssetFilter Preset => Filter ?? ImageAssetFilter.None;

    protected override async Task OnInitializedAsync()
    {
        _selected = CurrentAsset;
        _selectedIds = SelectedIds?.ToList() ?? [];
        _canCreate = (await CrudPermissions.LoadImagesAsync(Executor)).CanCreate;
        ResetFilter();
        await ApplyFilter();
    }

    private async Task LoadGridAsync()
    {
        _isLoading = true;
        try
        {
            _result = await Executor.QueryAsync(_query);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyFilter()
    {
        _query = new SearchImageAssetSummariesQuery
        {
            PageNumber = 1,
            PageSize = DefaultPageSize,
            Tags = _filter.Tags,
            Width = _filter.Width,
            Height = _filter.Height,
            MinWidth = _filter.MinWidth,
            MinHeight = _filter.MinHeight
        };

        _isFilterVisible = false;
        await LoadGridAsync();
    }

    private async Task ClearFilter()
    {
        ResetFilter();
        await ApplyFilter();
    }

    /// <summary>
    /// Back to the preset restrictions, as the AngularJS SearchQuery reset to its default params.
    /// </summary>
    private void ResetFilter()
    {
        _filter.Tags = Preset.Tags;
        _filter.Width = Preset.Width;
        _filter.Height = Preset.Height;
        _filter.MinWidth = Preset.MinWidth;
        _filter.MinHeight = Preset.MinHeight;
    }

    private async Task GoToPage(int pageNumber)
    {
        _query.PageNumber = pageNumber;
        await LoadGridAsync();
    }

    private bool IsSelected(int imageAssetId)
    {
        return IsMultiMode ? _selectedIds.Contains(imageAssetId) : imageAssetId == _selected?.ImageAssetId;
    }

    private void Select(IImageAssetRenderable image)
    {
        if (!IsMultiMode)
        {
            _selected = image;
        }
        else if (!_selectedIds.Remove(image.ImageAssetId))
        {
            _selectedIds.Add(image.ImageAssetId);
        }
    }

    private Task SelectAndCloseAsync(IImageAssetRenderable image)
    {
        // A double-click arrives after the two clicks, which have toggled a multi-mode row back off.
        if (IsMultiMode)
        {
            if (!_selectedIds.Contains(image.ImageAssetId))
            {
                _selectedIds.Add(image.ImageAssetId);
            }
        }
        else
        {
            _selected = image;
        }

        return OkAsync();
    }

    private async Task OkAsync()
    {
        if (IsMultiMode)
        {
            await OnSelectedIds.InvokeAsync(_selectedIds);
        }
        else if (_selected != null)
        {
            await OnSelected.InvokeAsync(_selected);
        }
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();

    private async Task OnUploadClosedAsync(int? imageAssetId)
    {
        _isUploadOpen = false;

        if (!imageAssetId.HasValue)
        {
            return;
        }

        var image = await Executor.QueryAsync(new GetImageAssetRenderDetailsByIdQuery(imageAssetId.Value));
        if (image != null)
        {
            await SelectAndCloseAsync(image);
        }
    }

    private sealed class PickerFilter
    {
        public string? Tags { get; set; }
        public int? Width { get; set; }
        public int? Height { get; set; }
        public int? MinWidth { get; set; }
        public int? MinHeight { get; set; }
    }
}
