@page "/admin-next/documents/{DocumentAssetId:int}"
@inject IAdminBlazorExecutor Executor
@inject NavigationManager Navigation

<PageTitle>@(_document?.Title ?? "Document") | Admin</PageTitle>

<PageHeader Title="@_document?.Title" ParentTitle="Documents" ParentHref="@AdminBlazorRoutes.Documents" />

@if (_document == null || _command == null || _permissions == null)
{
    <PageBody ContentType="form">
        @if (_notFound)
        {
            <p class="message warning perm">Sorry, that document could not be found.</p>
        }
        else
        {
            <TableContainer IsLoading="true" />
        }
    </PageBody>
}
else
{
    <AdminForm Model="_command" EditMode="_editMode" IsLoading="_isLoading" OnValidSubmit="SaveAsync">

        @if (!_editMode)
        {
            <PageActions>
                @if (_permissions.CanUpdate)
                {
                    <AdminButton Text="Edit" Class="main-cta" Disabled="_isLoading" OnClick="BeginEdit" />
                }
                @if (_permissions.CanDelete)
                {
                    <AdminButton Text="Delete" Disabled="_isLoading" OnClick="() => _isDeleteDialogOpen = true" />
                }
            </PageActions>
        }
        else
        {
            <PageActions>
                <AdminButtonSubmit Text="Save" IsLoading="_isLoading" Disabled="_isLoading" />
                <AdminButton Text="Cancel" Disabled="_isLoading" OnClick="CancelEdit" />
            </PageActions>
        }

        <PageBody ContentType="form">

            <FormStatus Errors="_errors" SuccessMessage="@_message" />

            <FormSection Title="Main">

                <FormFieldDocumentUpload Title="File"
                                         CurrentAsset="_document"
                                         @bind-Value="_command.File"
                                         Disabled="_isLoading" />

                <FormFieldText Title="Title" MaxLength="130"
                               Description="A short descriptive title e.g. 'Today's Menu' or 'Directions to our office'."
                               @bind-Value="_command.Title" />

                <FormFieldTextArea Title="Description" @bind-Value="_command.Description" />

                <FormFieldReadonly Title="Path" Description="Full path to the document file." Value="@_document.Url" />

                <FormFieldTags Title="CMS Tags" @bind-Value="_command.Tags" />

            </FormSection>

            <AuditDataSection AuditData="_document.AuditData" />

        </PageBody>

    </AdminForm>

    @if (_isDeleteDialogOpen)
    {
        <ConfirmDialog Title="Delete Document" Message="Are you sure you want to delete this document?"
                       OkButtonTitle="Yes, delete it"
                       OnOk="DeleteAsync"
                       OnClosed="OnDeleteClosed" />
    }
}

@code {
    private DocumentAssetDetails? _document;
    private AssetPermissions? _permissions;
    private UpdateDocumentAssetCommand? _command;
    private IReadOnlyCollection<ValidationError> _errors = [];
    private string? _message;
    private bool _editMode;
    private bool _isLoading;
    private bool _isDeleteDialogOpen;
    private bool _deleted;
    private bool _notFound;

    [Parameter] public int DocumentAssetId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _permissions ??= await AssetPermissions.LoadDocumentsAsync(Executor);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        var document = await Executor.QueryAsync(new GetDocumentAssetDetailsByIdQuery(DocumentAssetId));

        if (document == null)
        {
            _notFound = true;
            return;
        }

        _document = document;
        _command = MapCommand(document);
        _editMode = false;
    }

    private static UpdateDocumentAssetCommand MapCommand(DocumentAssetDetails document)
    {
        return new UpdateDocumentAssetCommand
        {
            DocumentAssetId = document.DocumentAssetId,
            Title = document.Title,
            Description = document.Description,
            Tags = document.Tags
        };
    }

    private void BeginEdit()
    {
        _editMode = true;
        _errors = [];
        _message = null;
    }

    private void CancelEdit()
    {
        _editMode = false;
        _command = MapCommand(_document!);
        _errors = [];
    }

    private async Task SaveAsync()
    {
        _isLoading = true;
        _errors = [];
        _message = null;

        try
        {
            var result = await Executor.ExecuteAsync(_command!);

            if (!result.Succeeded)
            {
                _errors = result.Errors;
                return;
            }

            await LoadAsync();
            _message = "Changes were saved successfully";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteAsync()
    {
        _errors = [];
        _message = null;

        var result = await Executor.ExecuteAsync(new DeleteDocumentAssetCommand { DocumentAssetId = DocumentAssetId });

        if (result.Succeeded)
        {
            _deleted = true;
        }
        else
        {
            _errors = result.Errors;
        }
    }

    private void OnDeleteClosed(bool confirmed)
    {
        _isDeleteDialogOpen = false;

        if (confirmed && _deleted)
        {
            Navigation.NavigateTo(AdminBlazorRoutes.Documents);
        }
    }
}
