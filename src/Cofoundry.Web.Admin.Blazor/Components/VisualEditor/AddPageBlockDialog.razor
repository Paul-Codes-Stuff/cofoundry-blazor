@using System.Reflection
@using Microsoft.Extensions.DependencyInjection
@inject IAdminBlazorExecutor Executor

@* Port of the AngularJS visual editor's AddBlock.html: pick a block type (skipped when the region allows only
   one), then fill in its data model and display template. Adds to a page version or a custom entity version. *@
<ModalDialog Title="@($"Add Content Block to {Args.RegionName}")" Size="large" OnClose="CancelAsync">

    @if (_step == 1)
    {
        <PageActions>
            <AdminButton Text="Next" Class="main-cta" Disabled="_selected == null" OnClick="() => GoToStep2Async()" />
            <AdminButton Text="Cancel" OnClick="CancelAsync" />
        </PageActions>

        <PageBody ContentType="form">
            <FormSection Title="Select a block type">
                <FormStatus Errors="_errors" />
                <div class="control-group">
                    <div class="control-group-area">
                        <TableContainer IsLoading="_blockTypes == null">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Block Type</th>
                                        <th>Description</th>
                                        <th>&nbsp;</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var blockType in _blockTypes ?? [])
                                    {
                                        var isSelected = blockType == _selected;

                                        <tr @key="blockType.PageBlockTypeId"
                                            class="@(isSelected ? "selected" : "selectable")"
                                            @onclick="() => _selected = blockType"
                                            @ondblclick="() => GoToStep2Async(blockType)">
                                            <td>@blockType.Name</td>
                                            <td>@blockType.Description</td>
                                            <td class="actions">
                                                <ButtonIcon Icon="@(isSelected ? "check-square-o" : "square-o")" Title="@(isSelected ? "Selected" : "Select")" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </TableContainer>
                    </div>
                </div>
            </FormSection>
        </PageBody>
    }
    else if (_schema == null || _form == null)
    {
        <PageBody ContentType="form"><TableContainer IsLoading="true" /></PageBody>
    }
    else
    {
        <AdminForm Model="_form" IsLoading="_isSaving" OnValidSubmit="SaveAsync">
            <PageActions>
                @if (_allowStep1)
                {
                    <AdminButton Text="Previous" Disabled="_isSaving" OnClick="() => _step = 1" />
                }
                <AdminButtonSubmit Text="Save" IsLoading="_isSaving" Disabled="_isSaving" />
                <AdminButton Text="Cancel" Disabled="_isSaving" OnClick="CancelAsync" />
            </PageActions>
            <PageBody ContentType="form">
                <FormSection Title="Settings">
                    <FormStatus Errors="_errors" />
                    <PageBlockFormFields Form="_form" Schema="_schema" />
                </FormSection>
            </PageBody>
        </AdminForm>
    }

</ModalDialog>

@code {
    private static readonly MethodInfo MemberwiseCloneMethod =
        typeof(object).GetMethod("MemberwiseClone", BindingFlags.Instance | BindingFlags.NonPublic)!;

    private int _step = 1;
    private bool _allowStep1;
    private IReadOnlyList<PageBlockTypeSummary>? _blockTypes;
    private PageBlockTypeSummary? _selected;
    private PageBlockTypeDetails? _schema;
    private PageBlockForm? _form;
    private IReadOnlyCollection<ValidationError> _errors = [];
    private bool _isSaving;

    [Parameter, EditorRequired] public VisualEditorPageData Context { get; set; } = default!;

    [Parameter, EditorRequired] public VisualEditorAddBlockArgs Args { get; set; } = default!;

    [Parameter] public EventCallback OnSaved { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var all = await Executor.QueryAsync(new GetAllPageBlockTypeSummariesQuery());

        // No permitted types means any type.
        _blockTypes = Args.PermittedBlockTypes.Count == 0
            ? all.ToList()
            : all.Where(t => Args.PermittedBlockTypes.Contains(t.FileName, StringComparer.OrdinalIgnoreCase)).ToList();

        if (_blockTypes.Count == 1)
        {
            await GoToStep2Async(_blockTypes[0]);
        }
        else
        {
            _allowStep1 = true;
        }
    }

    private async Task GoToStep2Async(PageBlockTypeSummary? blockType = null)
    {
        _selected = blockType ?? _selected;
        if (_selected == null)
        {
            return;
        }

        _step = 2;
        _errors = [];

        if (_schema?.PageBlockTypeId == _selected.PageBlockTypeId)
        {
            // Back from step 1 to the same type: keep what was entered.
            return;
        }

        _schema = null;
        _form = null;

        var schema = await Executor.QueryAsync(new GetPageBlockTypeDetailsByIdQuery(_selected.PageBlockTypeId));
        EntityNotFoundException.ThrowIfNull(schema, _selected.PageBlockTypeId);

        _schema = schema;
        _form = new PageBlockForm { DataModel = await CreateDefaultModelAsync(schema) };
    }

    private async Task<IPageBlockTypeDataModel> CreateDefaultModelAsync(PageBlockTypeDetails schema)
    {
        // A shallow copy, as EditNestedDataModelDialog: list fields replace lists rather than change them.
        if (schema.DefaultValue.Value is IPageBlockTypeDataModel defaultValue)
        {
            return (IPageBlockTypeDataModel)MemberwiseCloneMethod.Invoke(defaultValue, null)!;
        }

        var dataModelType = await Executor.WithServicesAsync(services => services
            .GetRequiredService<IPageBlockTypeDataModelTypeFactory>()
            .CreateByPageBlockTypeIdAsync(schema.PageBlockTypeId));

        return (IPageBlockTypeDataModel)Activator.CreateInstance(dataModelType)!;
    }

    private async Task SaveAsync()
    {
        if (_isSaving || _form == null || _schema == null)
        {
            return;
        }

        ICommand command = Context.IsCustomEntityRoute
            ? new AddCustomEntityVersionPageBlockCommand
            {
                CustomEntityVersionId = Context.VersionId,
                PageId = Context.PageId,
                PageBlockTypeId = _schema.PageBlockTypeId,
                PageBlockTypeTemplateId = _form.PageBlockTypeTemplateId,
                DataModel = _form.DataModel,
                PageTemplateRegionId = Args.PageTemplateRegionId,
                InsertMode = Args.InsertMode,
                AdjacentVersionBlockId = Args.AdjacentVersionBlockId
            }
            : new AddPageVersionBlockCommand
            {
                PageVersionId = Context.VersionId,
                PageBlockTypeId = _schema.PageBlockTypeId,
                PageBlockTypeTemplateId = _form.PageBlockTypeTemplateId,
                DataModel = _form.DataModel,
                PageTemplateRegionId = Args.PageTemplateRegionId,
                InsertMode = Args.InsertMode,
                AdjacentVersionBlockId = Args.AdjacentVersionBlockId
            };

        _isSaving = true;
        _errors = [];

        try
        {
            var result = await Executor.ExecuteAsync(command);
            if (!result.Succeeded)
            {
                _errors = result.Errors;
                return;
            }
        }
        finally
        {
            _isSaving = false;
        }

        await OnSaved.InvokeAsync();
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();
}
