@inject IAdminBlazorExecutor Executor

@* Port of the AngularJS visual editor's EditBlock.html: edits a block's data model and display template. *@
<ModalDialog Title="Edit Content Block" Size="large" OnClose="CancelAsync">

    @if (_schema == null || _form == null)
    {
        <PageBody ContentType="form"><TableContainer IsLoading="true" /></PageBody>
    }
    else
    {
        <AdminForm Model="_form" IsLoading="_isSaving" OnValidSubmit="SaveAsync">
            <PageActions>
                <AdminButtonSubmit Text="Save" IsLoading="_isSaving" Disabled="_isSaving" />
                <AdminButton Text="Cancel" Disabled="_isSaving" OnClick="CancelAsync" />
            </PageActions>
            <PageBody ContentType="form">
                <FormSection Title="Settings">
                    <FormStatus Errors="_errors" />
                    <PageBlockFormFields Form="_form" Schema="_schema" />
                </FormSection>
            </PageBody>
        </AdminForm>
    }

</ModalDialog>

@code {
    private PageBlockTypeDetails? _schema;
    private PageBlockForm? _form;
    private UpdatePageVersionBlockCommand? _pageCommand;
    private UpdateCustomEntityVersionPageBlockCommand? _customEntityCommand;
    private IReadOnlyCollection<ValidationError> _errors = [];
    private bool _isSaving;

    [Parameter, EditorRequired] public VisualEditorPageData Context { get; set; } = default!;

    [Parameter, EditorRequired] public VisualEditorBlockArgs Args { get; set; } = default!;

    [Parameter] public EventCallback OnSaved { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        IPageBlockTypeDataModel dataModel;
        int? templateId;
        int pageBlockTypeId;

        if (Context.IsCustomEntityRoute)
        {
            _customEntityCommand = await Executor.QueryAsync(
                new GetPatchableCommandByIdQuery<UpdateCustomEntityVersionPageBlockCommand>(Args.VersionBlockId));
            EntityNotFoundException.ThrowIfNull(_customEntityCommand, Args.VersionBlockId);
            (dataModel, templateId, pageBlockTypeId) = (_customEntityCommand.DataModel, _customEntityCommand.PageBlockTypeTemplateId, _customEntityCommand.PageBlockTypeId);
        }
        else
        {
            _pageCommand = await Executor.QueryAsync(
                new GetPatchableCommandByIdQuery<UpdatePageVersionBlockCommand>(Args.VersionBlockId));
            EntityNotFoundException.ThrowIfNull(_pageCommand, Args.VersionBlockId);
            (dataModel, templateId, pageBlockTypeId) = (_pageCommand.DataModel, _pageCommand.PageBlockTypeTemplateId, _pageCommand.PageBlockTypeId);
        }

        var schema = await Executor.QueryAsync(new GetPageBlockTypeDetailsByIdQuery(pageBlockTypeId));
        EntityNotFoundException.ThrowIfNull(schema, pageBlockTypeId);

        _schema = schema;
        _form = new PageBlockForm { DataModel = dataModel, PageBlockTypeTemplateId = templateId };
    }

    private async Task SaveAsync()
    {
        if (_isSaving || _form == null)
        {
            return;
        }

        ICommand command;
        if (_customEntityCommand != null)
        {
            _customEntityCommand.DataModel = _form.DataModel;
            _customEntityCommand.PageBlockTypeTemplateId = _form.PageBlockTypeTemplateId;
            command = _customEntityCommand;
        }
        else
        {
            _pageCommand!.DataModel = _form.DataModel;
            _pageCommand.PageBlockTypeTemplateId = _form.PageBlockTypeTemplateId;
            command = _pageCommand;
        }

        _isSaving = true;
        _errors = [];

        try
        {
            var result = await Executor.ExecuteAsync(command);
            if (!result.Succeeded)
            {
                _errors = result.Errors;
                return;
            }
        }
        finally
        {
            _isSaving = false;
        }

        await OnSaved.InvokeAsync();
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();
}
