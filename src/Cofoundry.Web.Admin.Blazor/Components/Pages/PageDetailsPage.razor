@page "/admin-next/pages/{PageId:int}"
@inject IAdminBlazorExecutor Executor
@inject NavigationManager Navigation

<PageTitle>@(_page?.PageRoute.FullUrlPath ?? "Page") | Admin</PageTitle>

<PageHeader Title="@_page?.PageRoute.FullUrlPath" ParentTitle="Pages" ParentHref="@AdminBlazorRoutes.Pages" />

@if (_page == null || _updateDraft == null || _update == null || _permissions == null)
{
    <PageBody ContentType="form">
        @if (_notFound)
        {
            <p class="message warning perm">Sorry, that page could not be found.</p>
        }
        else
        {
            <TableContainer IsLoading="true" />
        }
    </PageBody>
}
else
{
    var route = _page.PageRoute;
    var isGeneric = route.PageType == PageType.Generic;
    var isMarkedPublished = route.PublishStatus == PublishStatus.Published;

    <AdminForm @ref="_form" Model="_updateDraft" EditMode="_editMode" IsLoading="_isLoading" OnValidSubmit="() => SaveAsync(false)">

        @if (!_editMode)
        {
            <PageActions>
                @if (_permissions.CanUpdate)
                {
                    <AdminButton Text="Edit" Class="main-cta" Disabled="_isLoading" OnClick="BeginEdit" />
                }
                @if (isGeneric)
                {
                    <ButtonLink Text="Browse to page" Icon="eye" Href="@route.FullUrlPath" />
                }
                @if ((!isMarkedPublished || route.HasDraftVersion) && _permissions.CanPublish)
                {
                    <AdminButton Text="Publish" Disabled="_isLoading" OnClick="() => _dialog = Dialog.Publish" />
                }
                @if (isMarkedPublished && _permissions.CanPublish)
                {
                    <AdminButton Text="Unpublish" Disabled="_isLoading" OnClick="() => _dialog = Dialog.Unpublish" />
                }
                @if (_permissions.CanUpdateUrl)
                {
                    <AdminButton Text="Change Url" Disabled="_isLoading" OnClick="() => _dialog = Dialog.ChangeUrl" />
                }
                @* TODO: Access Control - needs the shared entity access editor and user area lookup (ported with Roles/Users). *@
                @if (_permissions.CanCreate)
                {
                    <AdminButton Text="Duplicate" Disabled="_isLoading" OnClick="() => _dialog = Dialog.Duplicate" />
                }
                @if (_permissions.CanDelete)
                {
                    <AdminButton Text="Delete" Disabled="_isLoading" OnClick="() => _dialog = Dialog.Delete" />
                }
            </PageActions>
        }
        else
        {
            <PageActions>
                <AdminButtonSubmit Text="Save Draft" IsLoading="_isLoading && !_isPublishing" Disabled="_isLoading" />
                <AdminButton Text="Save & Publish" IsLoading="_isLoading && _isPublishing" Disabled="_isLoading"
                             OnClick="() => SaveAsync(true)" />
                <AdminButton Text="Cancel" Disabled="_isLoading" OnClick="CancelEdit" />
            </PageActions>
        }

        <PageBody ContentType="form">

            <FormStatus Errors="_errors" SuccessMessage="@_message" />

            <FormSection Title="Main">

                <FormFieldText Title="Title" MaxLength="300"
                               Description="A few words descriptive page title, e.g. 'About the team'. Google SERP typically shows 50-60 characters"
                               @bind-Value="_updateDraft.Title" />

                <FormFieldReadonly Title="Market" Value="@route.Locale?.IETFLanguageTag" />

                <FormFieldContainer Title="Url">
                    @if (isGeneric)
                    {
                        <a href="@route.FullUrlPath">@route.FullUrlPath</a>
                    }
                    else
                    {
                        <span>@route.FullUrlPath</span>
                    }
                </FormFieldContainer>

                <FormFieldReadonly Title="Published Status" Value="@GetPublishStatusLabel(route)" />

                <FormFieldContainer Title="Publish Date">
                    @if (route.PublishDate.HasValue)
                    {
                        <span>@route.PublishDate.Value.ToString("D") at @route.PublishDate.Value.ToString("HH:mm:ss")</span>
                    }
                    else
                    {
                        <span>Not set</span>
                    }
                </FormFieldContainer>

                <FormFieldTags Title="CMS Tags" @bind-Value="_update.Tags" />

            </FormSection>

            <FormSection Title="SEO">

                <FormFieldTextArea Title="Meta Description" Rows="3" MaxLength="300"
                                   Description="Ideally 25-250 characters. The Google SERP shows only the first 150 characters"
                                   @bind-Value="_updateDraft.MetaDescription" />

                <FormFieldText Title="OpenGraph Title" MaxLength="300"
                               Description="Optional. The title that shows up when sharing the page on social media"
                               @bind-Value="_updateDraft.OpenGraphTitle" />

                <FormFieldTextArea Title="OpenGraph Description" Rows="3"
                                   Description="Optional. The description that shows up when sharing the page on social media"
                                   @bind-Value="_updateDraft.OpenGraphDescription" />

                <FormFieldImageAsset Title="OpenGraph Image"
                                     Description="Optional. An image to show up when sharing the page on social media"
                                     CurrentAsset="_page.LatestVersion.OpenGraph.Image"
                                     @bind-Value="_updateDraft.OpenGraphImageId" />

                <FormFieldCheckbox Title="Show in sitemap"
                                   Description="Indicates whether this page should be included in the site map file used by search engine robots"
                                   @bind-Value="_updateDraft.ShowInSiteMap" />

            </FormSection>

            <FormSection Title="Template Content">

                <FormSectionActions>
                    @if (_permissions.CanUpdate && _page.LatestVersion.Regions.Count > 0 && isGeneric && !_editMode)
                    {
                        <ButtonLink Text="Manage in Visual Editor" Icon="eye" Href="@(route.FullUrlPath + "?mode=edit")" />
                    }
                </FormSectionActions>

                @if (_page.LatestVersion.Regions.Count == 0)
                {
                    <div class="form-section-message"><p>This template has no managed content</p></div>
                }
                else
                {
                    if (_editMode)
                    {
                        <div class="form-section-message"><p>Page content is edited in the visual editor.</p></div>
                    }

                    <FormFieldContainer>
                        <TableContainer>
                            <table class="table">
                                @foreach (var region in _page.LatestVersion.Regions)
                                {
                                    <tbody>
                                        <tr>
                                            <th colspan="2"><h5 class="table-group-heading">Region: @region.Name</h5></th>
                                        </tr>
                                        @if (region.Blocks.Count == 0)
                                        {
                                            <tr><td colspan="2">No content</td></tr>
                                        }
                                        @foreach (var block in region.Blocks)
                                        {
                                            <tr>
                                                <td>@block.BlockType.Name</td>
                                                <td class="row-type" style="width:30px; text-align:center;"></td>
                                            </tr>
                                        }
                                    </tbody>
                                }
                            </table>
                        </TableContainer>
                    </FormFieldContainer>
                }

            </FormSection>

            <FormSection Title="Versions">
                <FormFieldContainer>
                    <TableContainer IsLoading="_isVersionsLoading">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Version</th>
                                    <th>Created</th>
                                    @if (!_editMode)
                                    {
                                        <th class="actions">Actions</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var version in _versions?.Items ?? [])
                                {
                                    <tr @key="version.PageVersionId">
                                        <td>@GetVersionLabel(version, route)</td>
                                        <td class="lowPriority"><AuditDataCell AuditData="version.AuditData" /></td>
                                        @if (!_editMode)
                                        {
                                            <td class="actions">
                                                @if (version.WorkFlowStatus == WorkFlowStatus.Draft)
                                                {
                                                    @if (_versions!.Items.Count > 1 && _permissions.CanUpdate)
                                                    {
                                                        <IconLink Icon="trash-o" Title="Discard draft" OnClick="() => _dialog = Dialog.DiscardDraft" />
                                                    }
                                                    @if (_permissions.CanPublish)
                                                    {
                                                        <IconLink Icon="cloud-upload" Title="Publish" OnClick="() => _dialog = Dialog.Publish" />
                                                    }
                                                }
                                                @if (version.IsLatestPublishedVersion && isMarkedPublished && _permissions.CanPublish)
                                                {
                                                    <IconLink Icon="cloud-download" Title="Un-publish" OnClick="() => _dialog = Dialog.Unpublish" />
                                                }
                                                @if (!version.IsLatestPublishedVersion && version.WorkFlowStatus == WorkFlowStatus.Published && _permissions.CanUpdate)
                                                {
                                                    <IconLink Icon="files-o" Title="Copy to draft" OnClick="() => BeginCopyToDraft(version)" />
                                                }
                                                @if (isGeneric)
                                                {
                                                    <IconLink Icon="external-link" Target="_blank"
                                                              Title="@($"Browse to page: {GetVersionLabel(version, route)}")"
                                                              Href="@GetBrowseUrl(route, version)" />
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </TableContainer>

                    <Pager PageNumber="_versions?.PageNumber ?? 1" PageCount="_versions?.PageCount ?? 0" OnPageChanged="GoToVersionsPage" />
                </FormFieldContainer>
            </FormSection>

            <AuditDataSection AuditData="_page.AuditData" />

        </PageBody>
    </AdminForm>

    @switch (_dialog)
    {
        case Dialog.Publish:
            <ConfirmDialog Title="Publish Page" Message="Are you sure you want to publish this page?"
                           OkButtonTitle="Yes, publish it"
                           OnOk="PublishAsync"
                           OnClosed="OnConfirmClosed" />
            break;
        case Dialog.Unpublish:
            <ConfirmDialog Title="Unpublish Page"
                           Message="Unpublishing this page will remove it from the live site and put it into draft status. Are you sure you want to continue?"
                           OkButtonTitle="Yes, unpublish it"
                           OnOk="UnpublishAsync"
                           OnClosed="OnConfirmClosed" />
            break;
        case Dialog.DiscardDraft:
            <ConfirmDialog Title="Discard Version"
                           Message="Are you sure you want to discard this draft? This will discard all changes since the page was last published."
                           OkButtonTitle="Yes, discard it"
                           OnOk="DiscardDraftAsync"
                           OnClosed="OnConfirmClosed" />
            break;
        case Dialog.CopyToDraft:
            <ConfirmDialog Title="Copy Page Version"
                           Message="A draft version of this page already exists. Copying this version will delete the current draft. Do you wish to continue?"
                           OkButtonTitle="Yes, replace it"
                           OnOk="CopyToDraftReplacingExistingAsync"
                           OnClosed="OnConfirmClosed" />
            break;
        case Dialog.Delete:
            <ConfirmDialog Title="Delete Page" Message="Are you sure you want to delete this page?"
                           OkButtonTitle="Yes, delete it"
                           OnOk="DeleteAsync"
                           OnClosed="OnDeleteClosed" />
            break;
        case Dialog.ChangeUrl:
            <ChangePageUrlDialog Page="_page" OnClosed="OnChangeUrlClosed" />
            break;
        case Dialog.Duplicate:
            <DuplicatePageDialog Page="_page" OnClosed="OnDuplicateClosed" />
            break;
    }
}

@code {
    private const int VersionsPageSize = 6;

    private enum Dialog { None, Publish, Unpublish, DiscardDraft, CopyToDraft, Delete, ChangeUrl, Duplicate }

    private AdminForm? _form;
    private Dialog _dialog;
    private PageDetails? _page;
    private PagePermissions? _permissions;
    private UpdatePageCommand? _update;
    private UpdatePageDraftVersionCommand? _updateDraft;
    private PagedQueryResult<PageVersionSummary>? _versions;
    private int _versionsPageNumber = 1;
    private int? _versionToCopy;
    private IReadOnlyCollection<ValidationError> _errors = [];
    private string? _message;
    private bool _editMode;
    private bool _isLoading;
    private bool _isPublishing;
    private bool _isVersionsLoading;
    private bool _notFound;

    [Parameter] public int PageId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _permissions ??= await PagePermissions.LoadAsync(Executor);
        await LoadAsync();
    }

    /// <summary>
    /// (Re)loads the page and its versions and resets the form, as AngularJS initData() did.
    /// </summary>
    private async Task LoadAsync()
    {
        _notFound = false;
        var page = await Executor.QueryAsync(new GetPageDetailsByIdQuery(PageId));

        if (page == null)
        {
            _notFound = true;
            return;
        }

        _page = page;
        _update = new UpdatePageCommand { PageId = page.PageId, Tags = page.Tags };
        _updateDraft = MapUpdateDraft(page);
        _editMode = false;

        await LoadVersionsAsync();
    }

    private async Task LoadVersionsAsync()
    {
        _isVersionsLoading = true;
        try
        {
            _versions = await Executor.QueryAsync(new GetPageVersionSummariesByPageIdQuery(PageId)
            {
                PageNumber = _versionsPageNumber,
                PageSize = VersionsPageSize
            });
        }
        finally
        {
            _isVersionsLoading = false;
        }
    }

    private Task GoToVersionsPage(int pageNumber)
    {
        _versionsPageNumber = pageNumber;
        return LoadVersionsAsync();
    }

    private static UpdatePageDraftVersionCommand MapUpdateDraft(PageDetails page)
    {
        var version = page.LatestVersion;

        return new UpdatePageDraftVersionCommand
        {
            PageId = page.PageId,
            Title = version.Title,
            MetaDescription = version.MetaDescription,
            OpenGraphTitle = version.OpenGraph.Title,
            OpenGraphDescription = version.OpenGraph.Description,
            OpenGraphImageId = version.OpenGraph.Image?.ImageAssetId,
            ShowInSiteMap = version.ShowInSiteMap
        };
    }

    /* EDITING */

    private void BeginEdit()
    {
        _editMode = true;
        _errors = [];
        _message = null;
    }

    private void CancelEdit()
    {
        _editMode = false;
        _update = new UpdatePageCommand { PageId = _page!.PageId, Tags = _page.Tags };
        _updateDraft = MapUpdateDraft(_page);
        _errors = [];
    }

    private async Task SaveAsync(bool publish)
    {
        if (_isLoading || _form == null || !_form.Validate())
        {
            return;
        }

        _updateDraft!.Publish = publish;
        _isPublishing = publish;
        _isLoading = true;
        _errors = [];
        _message = null;

        try
        {
            // Two commands, as in the AngularJS admin: tags first, then the draft version.
            var result = await Executor.ExecuteAsync(_update!);

            if (result.Succeeded)
            {
                result = await Executor.ExecuteAsync(_updateDraft);
            }

            if (!result.Succeeded)
            {
                _errors = result.Errors;
                return;
            }

            await LoadAsync();
            _message = "Changes were saved successfully";
        }
        finally
        {
            _isLoading = false;
        }
    }

    /* DIALOG ACTIONS */

    /// <summary>
    /// Runs a command for a confirm dialog. Errors are surfaced in the form status; the dialog
    /// closes and the page reloads either way (matching the AngularJS behaviour).
    /// </summary>
    private async Task RunAsync(ICommand command, string successMessage)
    {
        _errors = [];
        _message = null;

        var result = await Executor.ExecuteAsync(command);

        if (result.Succeeded)
        {
            _message = successMessage;
        }
        else
        {
            _errors = result.Errors;
        }
    }

    private async Task OnConfirmClosed(bool confirmed)
    {
        _dialog = Dialog.None;

        if (confirmed)
        {
            var message = _message;
            await LoadAsync();
            _message = _errors.Count == 0 ? message : null;
        }
    }

    private Task PublishAsync() =>
        RunAsync(new PublishPageCommand(PageId), "Page published successfully.");

    private Task UnpublishAsync() =>
        RunAsync(new UnPublishPageCommand(PageId), "The page has been unpublished and reverted to draft state.");

    private Task DiscardDraftAsync() =>
        RunAsync(new DeletePageDraftVersionCommand { PageId = PageId }, "Draft discarded successfully");

    private async Task BeginCopyToDraft(PageVersionSummary version)
    {
        _versionToCopy = version.PageVersionId;

        if (_page!.PageRoute.HasDraftVersion)
        {
            // Warn first: copying replaces the existing draft.
            _dialog = Dialog.CopyToDraft;
            return;
        }

        await CopyToDraftAsync();
    }

    private async Task CopyToDraftReplacingExistingAsync()
    {
        var result = await Executor.ExecuteAsync(new DeletePageDraftVersionCommand { PageId = PageId });

        if (!result.Succeeded)
        {
            _errors = result.Errors;
            return;
        }

        await CopyToDraftAsync();
    }

    private async Task CopyToDraftAsync()
    {
        await RunAsync(
            new AddPageDraftVersionCommand { PageId = PageId, CopyFromPageVersionId = _versionToCopy },
            "Draft created successfully.");

        if (_dialog == Dialog.None)
        {
            // No confirm dialog was involved, so reload here.
            var message = _message;
            await LoadAsync();
            _message = _errors.Count == 0 ? message : null;
        }
    }

    private async Task DeleteAsync()
    {
        var result = await Executor.ExecuteAsync(new DeletePageCommand { PageId = PageId });

        if (!result.Succeeded)
        {
            _errors = result.Errors;
        }
        else
        {
            _deleted = true;
        }
    }

    private bool _deleted;

    private Task OnDeleteClosed(bool confirmed)
    {
        _dialog = Dialog.None;

        if (confirmed && _deleted)
        {
            Navigation.NavigateTo(AdminBlazorRoutes.Pages);
        }

        return Task.CompletedTask;
    }

    private async Task OnChangeUrlClosed(bool changed)
    {
        _dialog = Dialog.None;

        if (changed)
        {
            await LoadAsync();
            _message = "Url Changed";
        }
    }

    private void OnDuplicateClosed(int? newPageId)
    {
        _dialog = Dialog.None;

        if (newPageId.HasValue)
        {
            Navigation.NavigateTo(AdminBlazorRoutes.PageDetails(newPageId.Value));
        }
    }

    /* LABELS */

    private static string GetPublishStatusLabel(PageRoute route)
    {
        if (route.PublishStatus == PublishStatus.Published
            && route.PublishDate.HasValue
            && route.PublishDate.Value > DateTime.UtcNow)
        {
            return "Pending Publish";
        }

        return route.PublishStatus.ToString();
    }

    private static string GetVersionLabel(PageVersionSummary version, PageRoute route)
    {
        if (version.WorkFlowStatus == WorkFlowStatus.Draft)
        {
            return version.WorkFlowStatus.ToString();
        }

        var label = "V" + version.DisplayVersion;

        return version.IsLatestPublishedVersion
            ? $"{label} ({GetPublishStatusLabel(route)})"
            : label;
    }

    /// <summary>
    /// Same url rules as the AngularJS UrlLibrary.visualEditorForVersion.
    /// </summary>
    private static string GetBrowseUrl(PageRoute route, PageVersionSummary version)
    {
        var url = route.FullUrlPath + "?";

        if (version.WorkFlowStatus == WorkFlowStatus.Draft)
        {
            return url + "mode=preview";
        }

        var isPublished = route.PublishStatus == PublishStatus.Published && route.HasPublishedVersion;

        if (version.IsLatestPublishedVersion && isPublished)
        {
            return url + "mode=live";
        }

        return url + "version=" + version.PageVersionId;
    }
}
