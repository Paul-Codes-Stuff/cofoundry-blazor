@page "/admin-next/roles/{RoleId:int}"
@inject IAdminBlazorExecutor Executor
@inject NavigationManager Navigation

<PageTitle>@(_role?.Title ?? "Role") | Admin</PageTitle>

<PageHeader Title="@_role?.Title" ParentTitle="Roles" ParentHref="@AdminBlazorRoutes.Roles" />

@if (_role == null || _command == null || _permissions == null)
{
    <PageBody ContentType="form">
        @if (_notFound)
        {
            <p class="message warning perm">Sorry, that role could not be found.</p>
        }
        else
        {
            <TableContainer IsLoading="true" />
        }
    </PageBody>
}
else
{
    <AdminForm Model="_command" EditMode="_editMode" IsLoading="_isLoading" OnValidSubmit="SaveAsync">

        @if (!_editMode)
        {
            <PageActions>
                @* The super admin role always has every permission, and editing your own role could lock you out. *@
                @if (_permissions.CanUpdate && !_role.IsSuperAdminRole && !_isCurrentRole)
                {
                    <AdminButton Text="Edit" Class="main-cta" Disabled="_isLoading" OnClick="BeginEdit" />
                }
                @* Built-in roles (those with a role code) are defined in code and can't be deleted. *@
                @if (_permissions.CanDelete && string.IsNullOrEmpty(_role.RoleCode))
                {
                    <AdminButton Text="Delete" Disabled="_isLoading" OnClick="() => _isDeleteDialogOpen = true" />
                }
            </PageActions>
        }
        else
        {
            <PageActions>
                <AdminButtonSubmit Text="Save" IsLoading="_isLoading" Disabled="_isLoading" />
                <AdminButton Text="Cancel" Disabled="_isLoading" OnClick="CancelEdit" />
            </PageActions>
        }

        <PageBody ContentType="form">

            <FormStatus Errors="_errors" SuccessMessage="@_message" />

            <FormSection Title="Role">
                <FormFieldReadonly Title="User Area" Value="@_role.UserArea.Name" />
                <FormFieldText Title="Title" MaxLength="50" Disabled="_role.IsAnonymousRole" @bind-Value="_command.Title" />
            </FormSection>

            <FormSection Title="Permissions">
                <FormFieldPermissionsCollection @bind-Value="_command.Permissions" Disabled="_isLoading" />
            </FormSection>

        </PageBody>

    </AdminForm>

    @if (_isDeleteDialogOpen)
    {
        <ConfirmDialog Title="Delete Role" Message="Are you sure you want to delete this role?"
                       OkButtonTitle="Yes, delete it"
                       OnOk="DeleteAsync"
                       OnClosed="OnDeleteClosed" />
    }
}

@code {
    private RoleDetails? _role;
    private CrudPermissions? _permissions;
    private UpdateRoleCommand? _command;
    private IReadOnlyCollection<ValidationError> _errors = [];
    private string? _message;
    private bool _isCurrentRole;
    private bool _editMode;
    private bool _isLoading;
    private bool _isDeleteDialogOpen;
    private bool _deleted;
    private bool _notFound;

    [Parameter] public int RoleId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_permissions == null)
        {
            _permissions = await CrudPermissions.LoadRolesAsync(Executor);
            _isCurrentRole = (await CurrentAdminUser.LoadAsync(Executor)).RoleId == RoleId;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        var role = await Executor.QueryAsync(new GetRoleDetailsByIdQuery(RoleId));

        if (role == null)
        {
            _notFound = true;
            return;
        }

        _role = role;
        _command = MapCommand(role);
        _editMode = false;
    }

    private static UpdateRoleCommand MapCommand(RoleDetails role)
    {
        return new UpdateRoleCommand
        {
            RoleId = role.RoleId,
            Title = role.Title,
            Permissions = role.Permissions
                .Select(p => new PermissionCommandData
                {
                    PermissionCode = p.PermissionType.Code,
                    EntityDefinitionCode = (p as IEntityPermission)?.EntityDefinition.EntityDefinitionCode
                })
                .ToList()
        };
    }

    private void BeginEdit()
    {
        _editMode = true;
        _errors = [];
        _message = null;
    }

    private void CancelEdit()
    {
        _editMode = false;
        _command = MapCommand(_role!);
        _errors = [];
    }

    private async Task SaveAsync()
    {
        _isLoading = true;
        _errors = [];
        _message = null;

        try
        {
            var result = await Executor.ExecuteAsync(_command!);

            if (!result.Succeeded)
            {
                _errors = result.Errors;
                return;
            }

            await LoadAsync();
            _message = "Changes were saved successfully";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteAsync()
    {
        _errors = [];
        _message = null;

        var result = await Executor.ExecuteAsync(new DeleteRoleCommand(RoleId));

        if (result.Succeeded)
        {
            _deleted = true;
        }
        else
        {
            _errors = result.Errors;
        }
    }

    private void OnDeleteClosed(bool confirmed)
    {
        _isDeleteDialogOpen = false;

        if (confirmed && _deleted)
        {
            Navigation.NavigateTo(AdminBlazorRoutes.Roles);
        }
    }
}
