@page "/admin-next/auth/reset-password"
@inherits AuthPageBase
@inject IAuthorizedTaskTokenUrlHelper AuthorizedTaskTokenUrlHelper

@* Port of AuthController.ResetPassword and the ResetPassword, ResetPasswordComplete and
   ResetPasswordRequestInvalid views from the AngularJS admin. The account recovery email links here
   with the token in the query (see AdminBlazorMailTemplateBuilder). The form posts back to the same
   url, so the token comes from the query on both requests. *@

@if (_invalidMessage != null)
{
    <PageTitle>Invalid password reset request | Admin</PageTitle>

    <h1>Invalid Request</h1>

    <div class="wrap">
        <form class="form-horizontal">
            <fieldset>
                <p class="message warning perm">@_invalidMessage</p>
                <div class="actions">
                    <p>
                        <a href="@AdminBlazorRoutes.ForgotPassword">Try again</a>
                    </p>
                </div>
            </fieldset>
        </form>
    </div>
}
else if (_complete)
{
    <PageTitle>Password Change Complete | Admin</PageTitle>

    <h1>Password Change Complete</h1>

    <div class="wrap">
        <form class="form-horizontal">
            <fieldset>
                <p>Your password has been changed</p>
                <div class="actions">
                    <p>
                        <a href="@AdminBlazorRoutes.Login">Click here to sign in</a>
                    </p>
                </div>
            </fieldset>
        </form>
    </div>
}
else
{
    <PageTitle>Reset password | Admin</PageTitle>

    @* The MVC view also put the password policy description in this heading, next to the same text
       under the field. Here it's only under the field. *@
    <h1>Reset Password</h1>

    <div class="wrap">
        <EditForm EditContext="_editContext" FormName="admin-reset-password" OnValidSubmit="CompleteAsync" class="form-horizontal" id="MainForm">
            <DataAnnotationsValidator />

            <fieldset>
                <p class="message warning perm">Please enter a new password</p>

                @if (_error != null)
                {
                    <div class="validation-summary-errors"><ul><li>@_error</li></ul></div>
                }

                <div class="control-group">
                    <label for="NewPassword" class="control-label">New password</label>
                    <div class="controls">
                        <InputText type="password" id="NewPassword" @bind-Value="Input.NewPassword" @attributes="_passwordAttributes" />
                        @if (!string.IsNullOrEmpty(_passwordPolicy?.Description))
                        {
                            <p class="help-inline"><small>@_passwordPolicy.Description</small></p>
                        }
                        @foreach (var message in _editContext.GetValidationMessages(() => Input.NewPassword))
                        {
                            <span class="help-block">@message</span>
                        }
                    </div>
                </div>

                <div class="control-group">
                    <label for="ConfirmNewPassword" class="control-label">Confirm new password</label>
                    <div class="controls">
                        <InputText type="password" id="ConfirmNewPassword" maxlength="2048" @bind-Value="Input.ConfirmNewPassword" />
                        @foreach (var message in _editContext.GetValidationMessages(() => Input.ConfirmNewPassword))
                        {
                            <span class="help-block">@message</span>
                        }
                    </div>
                </div>

                <div class="actions">
                    <input type="submit" class="btn btn-primary" value="Change password" />
                </div>
            </fieldset>
        </EditForm>
    </div>
}

<footer class="login-footer"></footer>

@code {
    [SupplyParameterFromForm] private ResetPasswordModel Input { get; set; } = default!;

    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private PasswordPolicyDescription? _passwordPolicy;
    private Dictionary<string, object> _passwordAttributes = [];
    private string? _token;
    private string? _invalidMessage;
    private string? _error;
    private bool _complete;

    protected override void OnInitialized()
    {
        Input ??= new();
        _editContext = new EditContext(Input);
        _messages = new ValidationMessageStore(_editContext);
    }

    protected override async Task OnAuthPageInitializedAsync()
    {
        if (await IsSignedInAsync())
        {
            Navigation.NavigateTo(AdminBlazorRoutes.Dashboard);
            return;
        }

        _token = AuthorizedTaskTokenUrlHelper.ParseTokenFromQuery(HttpContext.Request.Query);

        if (!IsPost)
        {
            var validationResult = await Repository
                .Users()
                .AccountRecovery()
                .Validate(new ValidateUserAccountRecoveryByEmailQuery()
                {
                    UserAreaCode = CofoundryAdminUserArea.Code,
                    Token = _token
                })
                .ExecuteAsync();

            if (!validationResult.IsSuccess)
            {
                _invalidMessage = validationResult.Error.Message;
                return;
            }
        }

        _passwordPolicy = await GetPasswordPolicyAsync();
        _passwordAttributes = GetPasswordInputAttributes(_passwordPolicy);
    }

    private async Task CompleteAsync()
    {
        try
        {
            await Repository
                .Users()
                .AccountRecovery()
                .CompleteAsync(new CompleteUserAccountRecoveryViaEmailCommand()
                {
                    UserAreaCode = CofoundryAdminUserArea.Code,
                    Token = _token ?? string.Empty,
                    NewPassword = Input.NewPassword
                });

            _complete = true;
        }
        catch (ValidationException ex)
        {
            _error = AddValidationError(ex, Input, _messages, _editContext);
        }
    }

    private sealed class ResetPasswordModel
    {
        [Required]
        [Display(Name = "New password")]
        public string NewPassword { get; set; } = string.Empty;

        [Required]
        [Display(Name = "Confirm new password")]
        [Compare(nameof(NewPassword), ErrorMessage = "Password does not match")]
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }
}
