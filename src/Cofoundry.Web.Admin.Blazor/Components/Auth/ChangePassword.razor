@page "/admin-next/auth/change-password"
@inherits AuthPageBase

@* Port of AuthController.ChangePassword and ChangePassword.cshtml from the AngularJS admin. Sign in
   sends a user here, without signing them in, when their password must be changed (e.g. a new user's
   temporary password). *@

<PageTitle>Change password | Admin</PageTitle>

<h1>Change Password</h1>

<div class="wrap">
    @if (_changed)
    {
        <form>
            <fieldset>
                <p>Your password has been updated.</p>

                <div class="actions">
                    <p>
                        <a href="@AdminBlazorRoutes.LoginWithReturnUrl(ValidReturnUrl)">Click here to login</a>
                    </p>
                </div>
            </fieldset>
        </form>
    }
    else
    {
        <EditForm EditContext="_editContext" FormName="admin-change-password" OnValidSubmit="ChangeAsync" class="form-horizontal" id="MainForm">
            <DataAnnotationsValidator />

            <fieldset>
                <p class="message warning perm">You must change your password before accessing the admin area.</p>

                @if (_error != null)
                {
                    <div class="validation-summary-errors"><ul><li>@_error</li></ul></div>
                }

                <div class="control-group">
                    <label for="Username" class="control-label">Email</label>
                    <div class="controls">
                        <InputText type="email" id="Username" maxlength="150" tabindex="1" @bind-Value="Input.Username" />
                        @foreach (var message in _editContext.GetValidationMessages(() => Input.Username))
                        {
                            <span class="help-block">@message</span>
                        }
                    </div>
                </div>

                <div class="control-group">
                    <label for="OldPassword" class="control-label">Current password</label>
                    <div class="controls">
                        <InputText type="password" id="OldPassword" @bind-Value="Input.OldPassword" />
                        @foreach (var message in _editContext.GetValidationMessages(() => Input.OldPassword))
                        {
                            <span class="help-block">@message</span>
                        }
                    </div>
                </div>

                <div class="control-group">
                    <label for="NewPassword" class="control-label">New password</label>
                    <div class="controls">
                        <InputText type="password" id="NewPassword" @bind-Value="Input.NewPassword" @attributes="_passwordAttributes" />
                        @if (!string.IsNullOrEmpty(_passwordPolicy?.Description))
                        {
                            <p class="help-inline"><small>@_passwordPolicy.Description</small></p>
                        }
                        @foreach (var message in _editContext.GetValidationMessages(() => Input.NewPassword))
                        {
                            <span class="help-block">@message</span>
                        }
                    </div>
                </div>

                <div class="control-group">
                    <label for="ConfirmNewPassword" class="control-label">Confirm new password</label>
                    <div class="controls">
                        <InputText type="password" id="ConfirmNewPassword" @bind-Value="Input.ConfirmNewPassword" />
                        @foreach (var message in _editContext.GetValidationMessages(() => Input.ConfirmNewPassword))
                        {
                            <span class="help-block">@message</span>
                        }
                    </div>
                </div>

                <div class="actions">
                    <input type="submit" class="btn btn-primary" value="Change password" />
                </div>
            </fieldset>
        </EditForm>
    }
</div>

<footer class="login-footer"></footer>

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm] private ChangePasswordModel Input { get; set; } = default!;

    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private PasswordPolicyDescription? _passwordPolicy;
    private Dictionary<string, object> _passwordAttributes = [];
    private string? _error;
    private bool _changed;

    private string? ValidReturnUrl => AdminBlazorRoutes.IsLocalUrl(ReturnUrl) ? ReturnUrl : null;

    protected override void OnInitialized()
    {
        Input ??= new();
        _editContext = new EditContext(Input);
        _messages = new ValidationMessageStore(_editContext);
    }

    protected override async Task OnAuthPageInitializedAsync()
    {
        var user = await Repository
            .Users()
            .Current()
            .Get()
            .AsUserContext()
            .ExecuteAsync();

        if (user.UserId.HasValue)
        {
            if (!user.IsPasswordChangeRequired)
            {
                Navigation.NavigateTo(AdminBlazorRoutes.Dashboard);
                return;
            }

            // As in the AngularJS admin: the user shouldn't be signed in, but if so, sign them out.
            await Repository
                .Users()
                .Authentication()
                .SignOutAsync();
        }

        _passwordPolicy = await GetPasswordPolicyAsync();
        _passwordAttributes = GetPasswordInputAttributes(_passwordPolicy);
    }

    private async Task ChangeAsync()
    {
        try
        {
            await Repository
                .Users()
                .UpdatePasswordByCredentialsAsync(new UpdateUserPasswordByCredentialsCommand()
                {
                    UserAreaCode = CofoundryAdminUserArea.Code,
                    Username = Input.Username,
                    NewPassword = Input.NewPassword,
                    OldPassword = Input.OldPassword
                });

            _changed = true;
        }
        catch (ValidationException ex)
        {
            _error = AddValidationError(ex, Input, _messages, _editContext);
        }
    }

    private sealed class ChangePasswordModel
    {
        [Required]
        [EmailAddress(ErrorMessage = "Please use a valid email address")]
        [Display(Name = "Email")]
        public string Username { get; set; } = string.Empty;

        [Required]
        [Display(Name = "Current password")]
        public string OldPassword { get; set; } = string.Empty;

        [Required]
        [Display(Name = "New password")]
        public string NewPassword { get; set; } = string.Empty;

        [Required]
        [Display(Name = "Confirm new password")]
        [Compare(nameof(NewPassword), ErrorMessage = "Password does not match")]
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }
}
