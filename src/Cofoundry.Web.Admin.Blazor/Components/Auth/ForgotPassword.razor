@page "/auth/forgot-password"
@inherits AuthPageBase

@* Port of AuthController.ForgotPassword and ForgotPassword.cshtml from the AngularJS admin. The email
   links to ResetPassword (see AdminBlazorMailTemplateBuilder). *@

<PageTitle>Forgotten password | Admin</PageTitle>

<h1>Forgotten your password?</h1>

<div class="wrap">
    @if (_sent)
    {
        <form>
            <fieldset>
                <p>Instructions on how to reset your password have been sent to your email address.</p>

                <div class="actions">
                    <p id="forgotPasswordLink">
                        <a href="@LoginUrl">Click here to login</a>
                    </p>
                </div>
            </fieldset>
        </form>
    }
    else
    {
        <EditForm EditContext="_editContext" FormName="admin-forgot-password" OnValidSubmit="SendAsync" class="form-horizontal" id="MainForm">
            <DataAnnotationsValidator />

            <fieldset>
                <p>Complete the form below to request a password reset.</p>

                <div class="control-group">
                    <label for="Username" class="control-label">Email</label>
                    <div class="controls">
                        <InputText type="email" id="Username" maxlength="128" @bind-Value="Input.Username" />
                        @foreach (var message in _editContext.GetValidationMessages(() => Input.Username))
                        {
                            <span class="help-block">@message</span>
                        }
                        @if (_error != null)
                        {
                            <div class="validation-summary-errors"><ul><li>@_error</li></ul></div>
                        }
                    </div>
                </div>

                <div class="actions">
                    <input type="submit" class="btn btn-primary" value="Reset password" />
                </div>
            </fieldset>
        </EditForm>
    }
</div>

<footer class="login-footer">
    <p class="login-footer-links">
        <a id="loginLink" class="popup" href="@LoginUrl">&lt; Back to login</a>
    </p>
</footer>

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "email")] private string? Email { get; set; }

    [SupplyParameterFromForm] private ForgotPasswordModel Input { get; set; } = default!;

    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private bool _sent;
    private string? _error;

    private string LoginUrl => AdminBlazorRoutes.LoginWithReturnUrl(AdminBlazorRoutes.IsLocalUrl(ReturnUrl) ? ReturnUrl : null);

    protected override void OnInitialized()
    {
        Input ??= new() { Username = Email ?? string.Empty };
        _editContext = new EditContext(Input);
        _messages = new ValidationMessageStore(_editContext);
    }

    protected override async Task OnAuthPageInitializedAsync()
    {
        if (!IsPost && await IsSignedInAsync())
        {
            Navigation.NavigateTo(AdminBlazorRoutes.Dashboard);
        }
    }

    private async Task SendAsync()
    {
        try
        {
            // Like the AngularJS admin, this doesn't say whether the email belongs to an account.
            await Repository
                .Users()
                .AccountRecovery()
                .InitiateAsync(new InitiateUserAccountRecoveryViaEmailCommand()
                {
                    UserAreaCode = CofoundryAdminUserArea.Code,
                    Username = Input.Username
                });

            _sent = true;
        }
        catch (ValidationException ex)
        {
            _error = AddValidationError(ex, Input, _messages, _editContext);
        }
    }

    private sealed class ForgotPasswordModel
    {
        [Required]
        [EmailAddress]
        [Display(Name = "Email")]
        public string Username { get; set; } = string.Empty;
    }
}
