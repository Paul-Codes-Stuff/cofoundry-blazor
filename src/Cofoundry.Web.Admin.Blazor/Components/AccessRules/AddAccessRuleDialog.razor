@inject IAdminBlazorExecutor Executor

@* Port of AddEntityAccessRule.html: choose a user area and, optionally, a role within it. *@
<ModalDialog Title="Add Access Rule" Size="large" OnClose="Cancel">

    @if (_userAreas == null)
    {
        <div class="modal-body"><TableContainer IsLoading="true" /></div>
    }
    else
    {
        <AdminForm Model="_model" OnValidSubmit="Add">

            <PageActions>
                <AdminButtonSubmit Text="Add" />
                <AdminButton Text="Cancel" OnClick="Cancel" />
            </PageActions>

            <PageBody ContentType="form">

                <FormSection Title="Permit Access To">

                    <FormFieldDropdown TValue="string" Title="User Area" Options="_userAreas" Required="true" DefaultItemText="Please choose"
                                       Description="The user area to restrict access to."
                                       Value="@_model.UserAreaCode"
                                       ValueChanged="OnUserAreaChanged"
                                       ValueExpression="() => _model.UserAreaCode" />

                    @* Searched as you type, as AngularJS searchRoles. Keyed by user area so a new area starts a new search. *@
                    <FormFieldFilteredDropdown @key="_model.UserAreaCode" Title="Role" Placeholder="Any role"
                                               Description="Optionally you can restrict access to a specific role within the user area."
                                               Disabled="string.IsNullOrEmpty(_model.UserAreaCode)"
                                               Search="SearchRolesAsync" GetText="GetRoleTitleAsync"
                                               @bind-Value="_model.RoleId" />

                </FormSection>

            </PageBody>
        </AdminForm>
    }

</ModalDialog>

@code {
    private readonly RuleModel _model = new();
    private IReadOnlyList<SelectOption<string>>? _userAreas;
    private readonly Dictionary<int, string> _roleTitles = [];

    /// <summary>
    /// Raised with the new rule, or null if the dialog was cancelled.
    /// </summary>
    [Parameter] public EventCallback<AccessRuleItem?> OnClosed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Access rules don't apply to Cofoundry admin users, so that area isn't offered.
        var userAreas = await UserAreaInfo.LoadAllAsync(Executor);

        _userAreas = userAreas
            .Where(a => !a.IsCofoundryAdminArea)
            .OrderBy(a => a.Name)
            .Select(a => new SelectOption<string>(a.UserAreaCode, a.Name))
            .ToList();

        if (_userAreas.Count == 1)
        {
            _model.UserAreaCode = _userAreas[0].Value;
        }
    }

    private void OnUserAreaChanged(string? userAreaCode)
    {
        _model.UserAreaCode = userAreaCode;
        _model.RoleId = null;
    }

    private async Task<IReadOnlyList<SelectOption<int>>> SearchRolesAsync(string? text)
    {
        if (string.IsNullOrEmpty(_model.UserAreaCode))
        {
            return [];
        }

        var roles = await Executor.QueryAsync(new SearchRolesQuery
        {
            Text = text,
            UserAreaCode = _model.UserAreaCode,
            ExcludeAnonymous = true
        });

        foreach (var role in roles.Items)
        {
            _roleTitles[role.RoleId] = role.Title;
        }

        return roles.Items.Select(r => new SelectOption<int>(r.RoleId, r.Title)).ToList();
    }

    // Only roles picked from a search can be selected, so their titles are already known.
    private Task<string?> GetRoleTitleAsync(int roleId) => Task.FromResult(_roleTitles.GetValueOrDefault(roleId));

    private Task Add()
    {
        var userArea = _userAreas!.First(a => a.Value == _model.UserAreaCode);
        var roleTitle = _model.RoleId is int roleId ? _roleTitles.GetValueOrDefault(roleId) : null;

        return OnClosed.InvokeAsync(new AccessRuleItem(null, userArea.Value, userArea.Text, _model.RoleId, roleTitle));
    }

    private Task Cancel() => OnClosed.InvokeAsync(null);

    private sealed class RuleModel
    {
        [Required]
        [Display(Name = "User Area")]
        public string? UserAreaCode { get; set; }

        public int? RoleId { get; set; }
    }
}
