@inherits IdCollectionFieldBase<ImageAssetRenderDetails>

@* [ImageCollection] properties: cms-form-field-image-asset-collection. A table of the chosen images in the
   collection's order; the picker opens in multi mode with the attribute's restrictions applied. *@
<div class="control-group">
    <div class="control-group-area @AreaCssClass">
        <label class="control-label">@Field.Title:</label>
        <div class="controls">
            <TableContainer IsLoading="IsLoading">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            @if (ShowInput)
                            {
                                <th class="actions">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Items.Count == 0)
                        {
                            <tr><td colspan="100" class="empty">None</td></tr>
                        }
                        @foreach (var (image, index) in Items.Select((image, i) => (image, i)))
                        {
                            <tr @key="image.ImageAssetId"
                                draggable="@(CanReorder ? "true" : null)"
                                @ondragstart="() => DragStart(index)"
                                @ondragover="() => { }"
                                @ondragover:preventDefault="CanReorder"
                                @ondrop="() => DropAsync(index)">
                                <td><TableCellImage Image="image" /></td>
                                <td>@image.Title</td>
                                @if (ShowInput)
                                {
                                    <td class="actions">
                                        <ButtonIcon Icon="external-link" Title="Edit image" External="true"
                                                    Href="@AdminBlazorRoutes.ImageDetails(image.ImageAssetId)" />
                                        <ButtonIcon Icon="trash-o" Title="Remove" OnClick="() => RemoveAsync(image)" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                @if (ShowInput)
                {
                    <div class="collection-actions">
                        <a href="" class="btn-icon" title="Add" @onclick="() => IsPickerOpen = true" @onclick:preventDefault>
                            <i class="fa fa-plus-circle"></i>
                        </a>
                    </div>
                }
            </TableContainer>
            <ValidationMessage For="() => Binding.Value" class="field-validation-error" />
        </div>
    </div>
    <FieldHelp Text="@Field.Description" />
</div>

@if (IsPickerOpen)
{
    <ImageAssetPickerDialog SelectedIds="Ids" Filter="DataModelAssetFilters.Image(Field)"
                            OnSelectedIds="OnPickedAsync" OnCancel="() => IsPickerOpen = false" />
}

@code {
    protected override Task<IReadOnlyDictionary<int, ImageAssetRenderDetails>> QueryAsync(IReadOnlyCollection<int> ids)
    {
        return Executor.QueryAsync(new GetImageAssetRenderDetailsByIdRangeQuery(ids));
    }

    protected override int GetId(ImageAssetRenderDetails asset) => asset.ImageAssetId;
}
