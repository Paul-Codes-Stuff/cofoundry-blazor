@inherits DataModelListFieldBase

@* [RadioList] properties: cms-form-field-radio-list. *@
@if (Options == null)
{
    <FormFieldContainer Title="@Field.Title" Description="@Field.Description">
        <div class="text-block-display-value">@(LoadError ?? "Loading...")</div>
    </FormFieldContainer>
}
else
{
    <FormFieldRadioList Id="@Field.Property.Name" Title="@Field.Title" Description="@Field.Description" ReadOnly="Field.IsReadOnly"
                        Options="Options" DefaultItemText="@DefaultItemText" Required="Field.IsRequired"
                        @bind-Value="_binding.Value" />
}

@code {
    private DataModelFieldBinding<string?> _binding = default!;

    protected override Task OnParametersSetAsync()
    {
        _binding = Field.Bind<string?>();

        return base.OnParametersSetAsync();
    }
}
