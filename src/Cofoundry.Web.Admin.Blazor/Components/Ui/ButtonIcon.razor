@* Port of cms-button-icon: an icon-only button, or a link when Href is set. *@
@if (string.IsNullOrEmpty(Href))
{
    <button type="button" class="btn-icon" title="@Title" disabled="@Disabled" @onclick="OnClick">
        <i class="fa fa-@Icon"></i>
    </button>
}
else
{
    <a href="@Href" class="btn-icon" title="@Title" target="@(External ? "_blank" : "_self")">
        <i class="fa fa-@Icon"></i>
    </a>
}

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    [Parameter] public string? Title { get; set; }

    [Parameter] public string? Href { get; set; }

    /// <summary>
    /// Opens <see cref="Href"/> in a new tab.
    /// </summary>
    [Parameter] public bool External { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
}
