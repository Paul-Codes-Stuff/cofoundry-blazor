<EditForm @ref="_editForm"
          Model="Model"
          OnValidSubmit="OnValidSubmit"
          class="@FormCssClass"
          novalidate>
    <DataAnnotationsValidator />

    <CascadingValue Value="EditMode" Name="EditMode">
        <CascadingValue Value="_fields" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </CascadingValue>
</EditForm>

@code {
    private EditForm? _editForm;
    private readonly AdminFormFields _fields = new();

    // Component attributes can't mix text and C#, so the class list is built as one expression.
    private string FormCssClass => string.Join(' ', new[]
    {
        "form-horizontal",
        CssClass,
        EditMode ? "form-edit-on" : "form-edit-off",
        IsLoading ? "loading" : null
    }.Where(c => !string.IsNullOrEmpty(c)));

    /// <summary>
    /// The object being edited, typically a domain command. Its data annotations drive client-side validation.
    /// </summary>
    [Parameter, EditorRequired] public object Model { get; set; } = default!;

    /// <summary>
    /// When false the fields render as read-only values rather than inputs.
    /// </summary>
    [Parameter] public bool EditMode { get; set; } = true;

    [Parameter] public bool IsLoading { get; set; }

    [Parameter] public string? CssClass { get; set; }

    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Runs validation for buttons that save without being the form's submit button (e.g.
    /// "Save &amp; Publish"). Returns true if the model is valid.
    /// </summary>
    public bool Validate() => _editForm?.EditContext?.Validate() ?? true;

    /// <summary>
    /// Re-validates a field the page changed in code, e.g. a title filled in from a file name, so a
    /// stale "required" message is cleared.
    /// </summary>
    public void NotifyFieldChanged<TField>(System.Linq.Expressions.Expression<Func<TField>> field)
    {
        _editForm?.EditContext?.NotifyFieldChanged(FieldIdentifier.Create(field));
    }
}
