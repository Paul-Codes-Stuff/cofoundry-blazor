@inherits FormFieldBase<TimeOnly?>

@* Port of cms-form-field-time: a native time input. Shows hours and minutes unless Step allows seconds. *@
<div class="control-group">
    <div class="control-group-area @AreaCssClass">
        <label class="control-label" for="@FieldId">@Title:</label>
        <div class="controls">
            @if (ShowInput)
            {
                <InputDate id="@FieldId"
                           TValue="TimeOnly?"
                           Type="InputDateType.Time"
                           Value="Value"
                           ValueChanged="ValueChanged"
                           ValueExpression="ValueExpression"
                           disabled="@Disabled"
                           min="@Min"
                           max="@Max"
                           step="@Step" />
                <FieldValidationMessage For="ValueExpression" Title="@Title" />
            }
            else if (Value.HasValue)
            {
                <div class="text-block-display-value">@Value.Value.ToString(Step < 60 ? "HH:mm:ss" : "HH:mm")</div>
            }
            else
            {
                <div class="text-block-display-value">None</div>
            }
        </div>
    </div>
    <FieldHelp Text="@Description" />
</div>

@code {
    /// <summary>
    /// The html min attribute, "HH:mm" or "HH:mm:ss".
    /// </summary>
    [Parameter] public string? Min { get; set; }

    [Parameter] public string? Max { get; set; }

    /// <summary>
    /// The html step attribute in seconds. Under 60 lets seconds be entered.
    /// </summary>
    [Parameter] public int? Step { get; set; }
}
