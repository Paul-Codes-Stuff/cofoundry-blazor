@inherits FormFieldBase<DateTime?>

@* Port of cms-form-field-date-time-local: a date and time without a time zone. *@
<div class="control-group">
    <div class="control-group-area @AreaCssClass">
        <label class="control-label" for="@FieldId">@Title:</label>
        <div class="controls">
            @if (ShowInput)
            {
                <InputDate id="@FieldId"
                           TValue="DateTime?"
                           Type="InputDateType.DateTimeLocal"
                           Value="Value"
                           ValueChanged="ValueChanged"
                           ValueExpression="ValueExpression"
                           disabled="@Disabled" />
                <FieldValidationMessage For="ValueExpression" Title="@Title" />
            }
            else if (Value.HasValue)
            {
                <div class="text-block-display-value">@Value.Value.ToString("D") @Value.Value.ToString("HH:mm")</div>
            }
            else
            {
                <div class="text-block-display-value">None</div>
            }
        </div>
    </div>
    <FieldHelp Text="@Description" />
</div>
