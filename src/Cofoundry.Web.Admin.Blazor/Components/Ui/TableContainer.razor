@* The child <table> needs class="table": the AngularJS directive added it to the DOM at runtime. *@
<div class="table-cont @(IsLoading ? "loading" : string.Empty)">
    <div class="table-wrap">@ChildContent</div>
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
