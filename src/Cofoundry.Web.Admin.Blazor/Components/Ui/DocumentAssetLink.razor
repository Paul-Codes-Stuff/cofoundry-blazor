@inject IDocumentAssetRouteLibrary DocumentRouteLibrary

@* Port of cms-document-asset: a download link labelled with the file name. *@
@if (Document != null)
{
    <a href="@DocumentRouteLibrary.DocumentAssetDownload(Document)">@Document.FileName.@Document.FileExtension</a>
}

@code {
    [Parameter] public IDocumentAssetRenderable? Document { get; set; }
}
