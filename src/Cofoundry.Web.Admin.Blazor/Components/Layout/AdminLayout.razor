@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject DebugSettings DebugSettings
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment

<div id="wrapper">

    <main id="main">

        <AdminNav />

        <div class="content">
            @* Stands in for the AngularJS ng-view element: .page-body's top margin collapses through
               this wrapper, which is what pushes the fixed .page-actions column below the header. *@
            <div>
                <CascadingValue Value="_modalDialogStack" IsFixed="true">
                    @* An unexpected exception in a page shows here (and is logged) instead of ending the
                       circuit, as the AngularJS admin's error dialog did. Navigating away recovers. *@
                    <ErrorBoundary @ref="_errorBoundary">
                        <ChildContent>
                            @Body
                        </ChildContent>
                        <ErrorContent Context="exception">
                            <PageBody ContentType="form">
                                <div class="form-message error perm">
                                    <p>Sorry, an unexpected error has occurred.</p>
                                    <p><a href="@Navigation.Uri" @onclick="Recover" @onclick:preventDefault>Try again</a></p>
                                    @if (DebugSettings.CanShowDeveloperExceptionPage(HostEnvironment))
                                    {
                                        <pre class="developer-exception">@exception</pre>
                                    }
                                </div>
                            </PageBody>
                        </ErrorContent>
                    </ErrorBoundary>
                </CascadingValue>
            </div>
        </div>

    </main>

    @* Dialogs render here, outside .content, whose z-index would otherwise trap them under the nav.
       The AngularJS admin appends them to <body> for the same reason. One outlet per stack level,
       later ones on top. *@
    <CascadingValue Value="_modalDialogStack" IsFixed="true">
        @for (var level = 0; level < ModalDialogStack.MaxDepth; level++)
        {
            <SectionOutlet SectionName="@ModalDialogStack.GetSectionName(level)" />
        }
    </CascadingValue>

    <footer>
        <p class="copyright">&copy; @DateTime.UtcNow.Year Cofoundry. All Rights Reserved. @CofoundryVersion</p>
    </footer>

</div>

@code {
    private readonly ModalDialogStack _modalDialogStack = new();
    private ErrorBoundary? _errorBoundary;

    // As the AngularJS layout: the version of Cofoundry.Web, the assembly of its ICofoundryHelper.
    private static readonly Version? CofoundryVersion = typeof(ICofoundryHelper).Assembly.GetName().Version;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Recover();

    private void Recover() => _errorBoundary?.Recover();

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
