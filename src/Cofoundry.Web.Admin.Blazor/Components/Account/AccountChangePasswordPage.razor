@page "/account/change-password"
@inject IAdminBlazorExecutor Executor
@inject NavigationManager Navigation

@* Port of the AngularJS Account module's ChangePassword route. Static SSR (see _Imports), so the domain can
   re-issue the auth cookie with the new security stamp. *@

<PageTitle>Change Password | Admin</PageTitle>

<PageHeader Title="Change Password" ParentTitle="My Account" ParentHref="@AdminBlazorRoutes.Account" />

<AdminForm Model="Input" FormName="admin-account-password" OnValidSubmit="SaveAsync">

    <PageActions>
        <AdminButtonSubmit Text="Change Password" />
        <ButtonLink Text="Cancel" Href="@AdminBlazorRoutes.Account" />
    </PageActions>

    <PageBody ContentType="form">

        <FormStatus Errors="_errors" />

        <FormSection Title="Password">

            <FormFieldText Title="Current Password" InputType="password" @bind-Value="Input.OldPassword"
                           Description="Your existing password is required to verify your account." />
            <FormFieldText Title="New Password" InputType="password" @bind-Value="Input.NewPassword"
                           Description="@_passwordPolicy?.Description" />
            <FormFieldText Title="Confirm new password" InputType="password" MaxLength="2048" @bind-Value="Input.ConfirmNewPassword" />

        </FormSection>

    </PageBody>

</AdminForm>

@code {
    private PasswordPolicyDescription? _passwordPolicy;
    private IReadOnlyCollection<ValidationError> _errors = [];

    [SupplyParameterFromForm(FormName = "admin-account-password")] private ChangePasswordFormModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _passwordPolicy = await Executor.QueryAsync(new GetPasswordPolicyDescriptionByUserAreaCodeQuery(CofoundryAdminUserArea.Code));
    }

    private async Task SaveAsync()
    {
        var result = await Executor.ExecuteAsync(new UpdateCurrentUserPasswordCommand()
        {
            OldPassword = Input.OldPassword!,
            NewPassword = Input.NewPassword!
        });

        if (!result.Succeeded)
        {
            _errors = result.Errors;
            return;
        }

        Navigation.NavigateTo(AdminBlazorRoutes.Account + "?saved=password");
    }

    private sealed class ChangePasswordFormModel
    {
        [Required]
        public string? OldPassword { get; set; }

        [Required]
        public string? NewPassword { get; set; }

        [Required]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords must match")]
        public string? ConfirmNewPassword { get; set; }
    }
}
