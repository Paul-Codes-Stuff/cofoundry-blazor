@inject NavigationManager Navigation

<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(AdminLayout)">
            <NotAuthorized>
                <LayoutView Layout="typeof(AdminLayout)">
                    <p class="message warning perm">
                        You are not signed in or do not have access to this page.
                        <a href="@AdminBlazorRoutes.LoginWithReturnUrl(new Uri(Navigation.Uri).PathAndQuery)" data-enhance-nav="false">Sign in</a>
                    </p>
                </LayoutView>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(AdminLayout)">
            <p class="message warning perm">Sorry, that page could not be found.</p>
        </LayoutView>
    </NotFound>
</Router>
