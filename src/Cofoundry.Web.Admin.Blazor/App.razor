<!DOCTYPE html>
<html class="no-js" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <base href="/" />

    <link rel="stylesheet" href="_content/Cofoundry.Web.Admin.Blazor/css/admin.css" />

    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />

    @* Blazor shows this when the circuit fails outside a page's error boundary (see AdminLayout), after
       which the page no longer responds. *@
    <div id="blazor-error-ui" class="form-message error">
        Sorry, an unexpected error has occurred and the page has stopped responding.
        <a href="" class="reload">Reload</a>
    </div>

    <script src="_framework/blazor.web.js"></script>
    @if (PageRenderMode != null)
    {
        <script src="@AdminAssetPaths.SessionCheckScript" data-url="@AdminBlazorRoutes.SessionCheck"></script>
    }
</body>
</html>

@code {
    // Prerendering is off: it would run every page's data loading twice (once for the HTTP
    // request and once when the circuit starts) for no benefit in an authenticated tool.
    private static readonly IComponentRenderMode AdminRenderMode = new InteractiveServerRenderMode(prerender: false);

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Pages marked [ExcludeFromInteractiveRouting] (sign-in/out) render as static SSR, because they
    // set or clear the auth cookie and so need a real HTTP request, which a circuit doesn't have.
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? AdminRenderMode : null;
}
