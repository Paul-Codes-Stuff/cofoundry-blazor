<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Cofoundry.Plugins.ErrorLogging.Admin.Blazor</PackageId>
    <Description>The error log module for the Cofoundry Blazor admin (Cofoundry.Web.Admin.Blazor).</Description>
    <PackageTags>Cofoundry Plugin ErrorLogging Admin Blazor</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Cofoundry.Plugins.ErrorLogging.Admin.Blazor</RootNamespace>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- -p:CofoundryPackageVersion swaps in the released packages, as in Cofoundry.Web.Admin.Blazor.csproj. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Cofoundry.Web.Admin.Blazor\Cofoundry.Web.Admin.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(CofoundryPackageVersion)' == ''">
    <ProjectReference Include="..\Cofoundry.Plugins.ErrorLogging\Cofoundry.Plugins.ErrorLogging.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(CofoundryPackageVersion)' != ''">
    <PackageReference Include="Cofoundry.Plugins.ErrorLogging" Version="$(CofoundryPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
