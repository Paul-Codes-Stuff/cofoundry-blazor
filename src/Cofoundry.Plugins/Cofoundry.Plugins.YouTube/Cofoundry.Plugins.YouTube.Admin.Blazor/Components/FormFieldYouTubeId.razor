@inject YouTubeVideoInfoService VideoInfoService

@* Port of cms-form-field-youtube-id, used by YouTubePickerDialog: a YouTube url or id, checked with YouTube
   when "Ok" is clicked. The video's details are passed to OnVideoSelected, or null when the input was
   cleared. *@
<div class="control-group">
    <div class="control-group-area @AreaCssClass">
        <label class="control-label" for="@InputId">Video Id:</label>

        <div class="controls">
            @if (!_isEditing)
            {
                <div>
                    @VideoId
                    <AdminButton Text="Change" OnClick="StartEditing" />
                </div>
            }
            else
            {
                <div>
                    <input type="text"
                           id="@InputId"
                           placeholder="enter a youtube url or id"
                           @bind="_input"
                           disabled="@_isLoading" />

                    <div class="form-field-input-actions">
                        <AdminButton Text="Ok" IsLoading="_isLoading" OnClick="UpdateVideoIdAsync" />
                        @if (!string.IsNullOrEmpty(VideoId))
                        {
                            <AdminButton Text="Cancel" Disabled="_isLoading" OnClick="CancelEditing" />
                        }
                    </div>

                    @if (_error != null)
                    {
                        <div class="field-validation-error">@_error</div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string? _shownVideoId;
    private string? _input;
    private string? _error;
    private bool _isEditing;
    private bool _isLoading;

    [CascadingParameter(Name = "FieldIdPrefix")] public string? FieldIdPrefix { get; set; }

    [Parameter] public string? VideoId { get; set; }

    [Parameter] public EventCallback<YouTubeVideo?> OnVideoSelected { get; set; }

    private string InputId => FieldIdPrefix + "YouTubeVideoId";

    private string AreaCssClass => _error == null ? "editmode" : "editmode invalid";

    protected override void OnParametersSet()
    {
        // As the AngularJS field watched its model: a new id ends editing, no id starts it.
        if (_shownVideoId != VideoId || (!_isEditing && string.IsNullOrEmpty(VideoId)))
        {
            _shownVideoId = VideoId;
            _input = VideoId;
            _isEditing = string.IsNullOrEmpty(VideoId);
        }
    }

    private void StartEditing()
    {
        _error = null;
        _isEditing = true;
    }

    private void CancelEditing()
    {
        _input = VideoId;
        _error = null;
        _isEditing = false;
    }

    private async Task UpdateVideoIdAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_input))
        {
            await OnVideoSelected.InvokeAsync(null);
            return;
        }

        var videoId = YouTubeVideoInfoService.ParseVideoId(_input);

        if (videoId == null)
        {
            _error = "The url/id is invalid";
            return;
        }

        if (videoId == VideoId)
        {
            CancelEditing();
            return;
        }

        YouTubeVideo? video;
        _isLoading = true;
        try
        {
            video = await VideoInfoService.GetVideoInfoAsync(videoId);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = "There was a problem accessing YouTube";
            return;
        }
        finally
        {
            _isLoading = false;
        }

        if (video == null)
        {
            _error = "Video not found";
            return;
        }

        _input = videoId;
        await OnVideoSelected.InvokeAsync(video);
    }
}
