@* Port of YouTubePickerDialog: a video id or url, a preview, and the title and description, which default to
   YouTube's when an API key is set (YouTubeSettings) and can be changed. It edits a copy, so Cancel leaves
   the field as it was. *@
<ModalDialog Title="YouTube Video" Size="large" OnClose="CancelAsync">
    @* Enter in the id input mustn't close the dialog, so the form has no submit handler: Ok is a click. *@
    <AdminForm Model="_form">
        <PageActions>
            <AdminButton Text="Ok" Disabled="string.IsNullOrEmpty(_video.Id)" OnClick="OkAsync" />
            <AdminButton Text="Cancel" OnClick="CancelAsync" />
        </PageActions>
        <PageBody>
            <FormSection Title="Video Settings">

                <FormFieldYouTubeId VideoId="@_video.Id" OnVideoSelected="OnVideoSelected" />

                <FormFieldContainer Title="Preview">
                    <div class="form-field-youtube-preview">
                        <YouTubeVideoPreview VideoId="@_video.Id" />
                    </div>
                </FormFieldContainer>

                <FormFieldText Title="Title" @bind-Value="_video.Title" />
                <FormFieldTextArea Title="Description" @bind-Value="_video.Description" />

            </FormSection>
        </PageBody>
    </AdminForm>
</ModalDialog>

@code {
    private readonly object _form = new();
    private YouTubeVideo _video = new();

    [Parameter] public YouTubeVideo? CurrentVideo { get; set; }

    [Parameter] public EventCallback<YouTubeVideo?> OnSelected { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    protected override void OnInitialized()
    {
        _video = CurrentVideo == null ? new() : Copy(CurrentVideo);
    }

    private void OnVideoSelected(YouTubeVideo? video)
    {
        _video = video ?? new();
    }

    private Task OkAsync() => OnSelected.InvokeAsync(string.IsNullOrEmpty(_video.Id) ? null : _video);

    private Task CancelAsync() => OnCancel.InvokeAsync();

    private static YouTubeVideo Copy(YouTubeVideo video) => new()
    {
        Id = video.Id,
        Title = video.Title,
        Description = video.Description,
        PublishDate = video.PublishDate,
        ThumbnailUrl = video.ThumbnailUrl,
        ThumbnailWidth = video.ThumbnailWidth,
        ThumbnailHeight = video.ThumbnailHeight
    };
}
