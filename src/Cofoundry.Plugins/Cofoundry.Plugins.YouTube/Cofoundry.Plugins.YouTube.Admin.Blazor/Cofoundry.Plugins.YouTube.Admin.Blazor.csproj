<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Cofoundry.Plugins.YouTube.Admin.Blazor</PackageId>
    <Description>Adds the YouTube video field to the Cofoundry Blazor admin (Cofoundry.Web.Admin.Blazor).</Description>
    <PackageTags>Cofoundry YouTube Admin Blazor</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Cofoundry.Plugins.YouTube.Admin.Blazor</RootNamespace>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- -p:CofoundryPackageVersion swaps in the released packages, as in Cofoundry.Web.Admin.Blazor.csproj. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Cofoundry.Web.Admin.Blazor\Cofoundry.Web.Admin.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(CofoundryPackageVersion)' == ''">
    <ProjectReference Include="..\Cofoundry.Plugins.YouTube.Domain\Cofoundry.Plugins.YouTube.Domain.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(CofoundryPackageVersion)' != ''">
    <PackageReference Include="Cofoundry.Plugins.YouTube.Domain" Version="$(CofoundryPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
